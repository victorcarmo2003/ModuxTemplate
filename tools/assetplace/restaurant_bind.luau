-- AST-027 front pieces cloned and stretched to the long window: Shutter_Panel (+ hinge), string lights, light bar, logo, mast
do
	local OLD_CX, NEW_CX = -46.34, F(42.5, 0, 0).X -- window centres (world X), measured on the AST-027 Body by raycast
	local S = (WIN_X1 - WIN_X0) / 21.75
	local DZ = F(0, 0, 54).Z - 17.82 -- front outer faces
	local DY = WIN_Y1 - 8.3 -- window tops
	local ROOF_DY = (ROOF_Y + 1) - 9.93
	local function mapFront(cf, roof)
		local p = cf.Position
		local np = if roof
			then Vector3.new(NEW_CX + (p.X - OLD_CX), p.Y + ROOF_DY, p.Z + DZ)
			else Vector3.new(NEW_CX + (p.X - OLD_CX) * S, p.Y + DY, p.Z + DZ)
		return CFrame.new(np) * (cf - cf.Position)
	end
	local function stretch(part)
		if part.Name == "Detail_Logo" or string.find(part.Name, "Bulb") then
			return
		end
		local rv, lv = part.CFrame.RightVector, part.CFrame.LookVector
		if math.abs(rv.X) > 0.9 and (part.Size.X >= 3 or part.Name == "Detail_Wire") then
			part.Size = Vector3.new(part.Size.X * S, part.Size.Y, part.Size.Z)
		elseif math.abs(lv.X) > 0.9 and part.Size.Z >= 3 then
			part.Size = Vector3.new(part.Size.X, part.Size.Y, part.Size.Z * S)
		end
	end
	local deco = folder(front, "TrailerDeco")
	local function cloneFront(src, roof, into)
		local c = src:Clone()
		if fromBackup then
			retag(c)
		end
		local parts = if c:IsA("BasePart") then { c } else {}
		for _, d in c:GetDescendants() do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
		local atts = {}
		for _, d in c:GetDescendants() do
			if d:IsA("Attachment") then
				atts[d] = d.WorldCFrame
			end
		end
		for _, d in parts do
			d.CFrame = mapFront(d.CFrame, roof)
			if not roof then
				stretch(d)
			end
		end
		for a, w in atts do
			a.WorldCFrame = mapFront(w, roof)
		end
		c.Parent = into
		return c
	end
	if not front:FindFirstChild("Shutter_Panel") then
		local sp = source:FindFirstChild("Shutter_Panel")
		if sp then
			local c = cloneFront(sp, false, front)
			c:SetAttribute("TrailerLoweredV1", nil)
			c:SetAttribute("RST", true)
		else
			L("[warn] trailer Shutter_Panel missing: no service window flap")
		end
	end
	if #deco:GetChildren() == 0 then
		for _, ch in source:GetChildren() do
			if ch:IsA("BasePart") and string.match(ch.Name, "^Detail_") then
				cloneFront(ch, false, deco)
			elseif ch:IsA("Model") and string.match(ch.Name, "^TRL%-LIGHTS") then
				local cy = ch:GetBoundingBox().Position.Y
				cloneFront(ch, cy > 10, deco)
			end
		end
	end
end


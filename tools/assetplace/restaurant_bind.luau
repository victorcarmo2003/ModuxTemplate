-- 8. sign CORNER DOGS on the parapet, OPEN neon; tables, bushes, fence, gate, lamps --------------------------------------
if extra then
	local sign = extra:FindFirstChild("TrailerSign_HotDog")
	if sign then
		-- on the trailer roof (top 10.45): board bottom ~10.6, close to the front edge
		poseTo(sign, face(F(42.5, 13.2, 56.2), DIR.N), "Extra:TrailerSign_HotDog")
	end
	-- the 4 picnic tables -> TBL-1..4 (and anything sitting on them: candles / torches)
	local TBL = {
		{ 29.5, 43.4 }, -- TBL-1 west, back row (nearest the pickup)
		{ 42.0, 43.4 }, -- TBL-2 east, back row
		{ 29.5, 35.8 }, -- TBL-3 west, front row
		{ 42.0, 35.8 }, -- TBL-4 east, front row
	}
	local tables = {}
	for _, t in CS:GetTagged("SeatTable") do
		if t:IsDescendantOf(workspace) and t:IsA("Model") then
			table.insert(tables, t)
		end
	end
	table.sort(tables, function(a, b)
		local pa = a:GetAttribute("_RST_OrigCF") or a:GetPivot()
		local pb = b:GetAttribute("_RST_OrigCF") or b:GetPivot()
		return pa.Position.X > pb.Position.X -- world X descending = MAP west first
	end)
	local loose = {}
	for _, d in extra:GetChildren() do
		if d.Name == "FireTorch" then
			table.insert(loose, d)
		end
	end
	for i, t in tables do
		if i > 4 then
			L("[warn] extra SeatTable " .. t:GetFullName())
			continue
		end
		local orig = t:GetAttribute("_RST_OrigCF") or t:GetPivot()
		local target = face(F(TBL[i][1], 0.4, TBL[i][2]), DIR.S)
		local T = target * orig:Inverse()
		for _, l in loose do
			local lorig = l:GetAttribute("_RST_OrigCF") or l:GetPivot()
			if (lorig.Position - orig.Position).Magnitude < 3.5 then
				poseTo(l, T * lorig, "Torch:TBL-" .. i)
			end
		end
		poseTo(t, target, "Table:TBL-" .. i)
		t:SetAttribute("TableIndex", i)
		t:SetAttribute("RestaurantId", "TBL-" .. i)
		t:SetAttribute("TableGroup", "Restaurant")
	end
	L("tables placed: " .. math.min(#tables, 4))
	-- crates DOGS / BUNS / MUSTARD (decor only, no gameplay): rev. 4 (2026-10-17, owner: they sat on DROP-R in the way of the
	-- stock prompts) -> OUT of the pantry, the service nook east of it (sidewalk Y 0.4, against the kitchen back wall Z 72,
	-- clear of the breaker approach X <= 52.5 and of Jack_3 at X 57.2..58): two stacked + one in front, slightly turned
	local crates = {
		Crate_2 = face(F(54.2, 0.4, 73.5), DIR.N),
		Crate_3 = face(F(54.2, 2.4, 73.5), DIR.N) * CFrame.Angles(0, math.rad(8), 0), -- stacked on Crate_2
		Crate_1 = face(F(54.7, 0.4, 76.05), DIR.N) * CFrame.Angles(0, math.rad(-10), 0),
	}
	for n, cf in crates do
		local c = extra:FindFirstChild(n)
		if c then
			-- crate pivots are at the box centre (y +1.0 over the base)
			local base = c:GetPivot().Y - (c:GetBoundingBox().Position.Y - c:GetBoundingBox().Y / 2 + 0)
			local _, size = c:GetBoundingBox()
			poseTo(c, cf * CFrame.new(0, size.Y / 2, 0), "Extra:" .. n)
		end
	end
	-- table trash bins (TrashBin, owner's) -> service strip behind the building
	local bins = {}
	for _, d in extra:GetChildren() do
		if d.Name == "P2" and d:IsA("BasePart") then
			table.insert(bins, d)
		end
	end
	table.sort(bins, function(a, b)
		return tostring(a:GetAttribute("BinId")) < tostring(b:GetAttribute("BinId"))
	end)
	for i, b in bins do
		poseTo(b, CFrame.new(F(56.0 + (i - 1) * 7.4, 2.5, 83.0)), "Bin:" .. tostring(b:GetAttribute("BinId") or i)) -- off the enlarged pantry (owner: move the bins)
	end
	-- menu board -> DT-MENU on the island (faces north: the car coming down reads it)
	local menuB = extra:FindFirstChild("MenuBoard")
	if menuB then
		poseTo(menuB, face(F(68.25, 4.6, 44), DIR.N), "Extra:MenuBoard")
		if ART then
			for i, x in { 66.3, 70.2 } do
				box(drive, "Menu_Post" .. i, x - 0.1, x + 0.1, 0.75, 2.4, 43.95, 44.15, { Color = C.SteelDark, CanCollide = false, art = { Color = C.SteelDark, Material = Enum.Material.Metal } })
			end
		end
	end
	-- old Pad decor in the lot
	local plant = extra:FindFirstChild("AST-102_PottedPlant")
	if plant then
		poseTo(plant, face(F(32.4, 0.56, 33.0), DIR.N), "Extra:PottedPlant")
	end
	local planters = {}
	for _, d in extra:GetChildren() do
		if d.Name == "AST-100_PlanterBushes" then
			table.insert(planters, d)
		end
	end
	-- BUSH-R: 5 planters along X 58.75 (2 existing + 3 pack clones), long side along Z
	for i = 1, 5 do
		local cf = face(F(58.75, 0.56, 34.6 + (i - 1) * 4.2), DIR.E)
		if planters[i] then
			poseTo(planters[i], cf, "Planter:" .. i)
		elseif ART then
			packAsset(patio, "BUSH-R_" .. i, "AST-100_PlanterBushes", cf)
		end
	end
	-- light poles of the old Pad (they held the trailer string lights) -> backup
	for _, d in extra:GetChildren() do
		if d.Name == "LightPole" or d.Name == "LightPoleFoot" then
			toBackup(d, "Pad string-light pole (trailer only)")
		end
	end
	-- old Pad borders and floor -> backup (the patio has its own floor)
	for _, n in { "Border_N", "Border_S", "Border_E", "Border_W" } do
		toBackup(extra:FindFirstChild(n), "Pad border (trailer only)")
	end
	-- queue marks -> Q1..Q5 (moved below with the points)

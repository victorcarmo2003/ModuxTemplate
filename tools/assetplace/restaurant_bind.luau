-- graph -------------------------------------------------------------------------------------------------------------------
local function nodePart(id)
	return nodesF:FindFirstChild(id) or pts:FindFirstChild(id)
end
local VLINKS = {} -- links as this run leaves them (diff mode never writes)
local function setLinks(id, list)
	local p = nodePart(id)
	if not p then
		L("[warn] node " .. id .. " missing")
		return
	end
	VLINKS[id] = table.concat(list, ",")
	if DIFF then
		return
	end
	remember(p)
	p:SetAttribute("Links", VLINKS[id])
end
local function linksOf(id)
	local p = nodePart(id)
	local t = {}
	if p then
		for s in string.gmatch(tostring(VLINKS[id] or p:GetAttribute("Links") or ""), "[^,]+") do
			table.insert(t, s)
		end
	end
	return t
end
local function drop(id, other)
	local l = linksOf(id)
	local i = table.find(l, other)
	if i then
		table.remove(l, i)
		setLinks(id, l)
	end
end
local function link(a, b)
	for _, pair in { { a, b }, { b, a } } do
		local l = linksOf(pair[1])
		if not table.find(l, pair[2]) then
			table.insert(l, pair[2])
			setLinks(pair[1], l)
		end
	end
end
local function moveNode(id, x, z)
	local p = nodePart(id)
	if p then
		poseTo(p, CFrame.new(F(x, p.Position.Y > 0.42 and FLOOR or 0.4, z)), "Node:" .. id)
	end
	return p
end
local function newNode(id, x, y, z)
	local p = nodesF:FindFirstChild(id)
	if DIFF then
		if p then
			poseTo(p, CFrame.new(F(x, y, z)), "Node:" .. id)
		else
			L("[diff] node " .. id .. " missing in the place")
		end
		return p
	end
	if not p then
		local tpl = nodesF:FindFirstChild("N-Z02-05")
		p = tpl:Clone()
		p.Name = id
		p:SetAttribute("NodeId", id)
		p:SetAttribute("Links", "")
		for _, a in { "_RST_OrigCF", "_RST_OrigSize", "_RST_OrigLinks", "_RST_Moved" } do
			p:SetAttribute(a, nil)
		end
		p:SetAttribute("_RST_Created", true)
		p.Parent = nodesF
		L("node created: " .. id)
	end
	local ov = OVERRIDES.External["Node:" .. id]
	p.CFrame = if ov and ov.CF then toCF(ov.CF) else CFrame.new(F(x, y, z))
	return p
end

			for a, oldWorld in atts do
				local focusName = string.gsub(a.Name, "^CamAnchor", "Focus")
				focusName = string.gsub(focusName, "^Att_Stand", "Focus")
				local focus = a.Parent:FindFirstChild(focusName)
				local probe = if focus and atts[focus] then atts[focus].Position else oldWorld.Position
				local T = nearestTransform(probe)
				if string.find(a.Name, "Window") then
					T = TB
				end
				a.WorldCFrame = T * oldWorld
			end
		end
		finishLoose(c)
	elseif n == "PrepTargets" then
		local c = cloneLoose(src, function(part)
			local obj = part:GetAttribute("Object")
			local cname = obj and byMapId[obj]
			return (cname and transforms[cname]) or TB
		end)
		finishLoose(c)
	elseif n == "UpgradePieces" and src:IsA("Folder") then
		-- two folders share the name: keep them apart by content
		local key = "UpgradePieces_" .. (src:GetChildren()[1] and src:GetChildren()[1].Name or "x")
		if not kitchen:FindFirstChild(key) then
			local c = src:Clone()
			if fromBackup then
				retag(c)
			end
			c.Name = key
			local lift = if string.find(key, "TrailerLights") then CFrame.new(0, 0.52, 0) else CFrame.new()
			for _, d in c:GetDescendants() do
				if d:IsA("BasePart") then
					d.CFrame = lift * TB * d.CFrame
				end
			end
			c.Parent = kitchen
		end
	end
end


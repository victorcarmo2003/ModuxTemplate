-- loose groups are rebuilt from the source every run (a scratch clone, transformed), then copied pose by pose onto the live
-- copy, so a layout change of the stations moves their prep anchors too; finishLoose() does the copy
local function cloneLoose(src, transformFor)
	local c = src:Clone()
	if fromBackup then
		retag(c)
	end
	-- capture old world poses of attachments before moving parts
	local atts = {}
	for _, d in c:GetDescendants() do
		if d:IsA("Attachment") then
			atts[d] = d.WorldCFrame
		end
	end
	for _, d in c:GetDescendants() do
		if d:IsA("BasePart") then
			d.CFrame = transformFor(d, d.CFrame) * d.CFrame
		end
	end
	return c, true, atts
end
local function relPath(inst, top)
	local t = {}
	while inst and inst ~= top do
		local n = 0
		for _, sib in inst.Parent:GetChildren() do
			if sib.Name == inst.Name then
				n += 1
			end
			if sib == inst then
				break
			end
		end
		table.insert(t, 1, inst.Name .. "#" .. n)
		inst = inst.Parent
	end
	return table.concat(t, "/")
end
local function finishLoose(c, name)
	local live = kitchen:FindFirstChild(name or c.Name)
	if not (live and live.ClassName == c.ClassName) then
		if name then
			c.Name = name
		end
		c.Parent = kitchen
		return
	end
	local poses = {}
	for _, d in c:GetDescendants() do
		if d:IsA("BasePart") then
			poses[relPath(d, c)] = d.CFrame
		elseif d:IsA("Attachment") then
			poses[relPath(d, c)] = d.CFrame -- local, set after the parts
		end
	end
	for _, d in live:GetDescendants() do
		local cf = poses[relPath(d, live)]
		if cf and d:IsA("BasePart") then
			d.CFrame = cf
		end
	end
	for _, d in live:GetDescendants() do
		local cf = poses[relPath(d, live)]
		if cf and d:IsA("Attachment") then
			d.CFrame = cf
		end
	end
	c:Destroy() -- scratch copy
end

local transforms = {}
local function rigid(oldCenter, newCenter, oldFront, newFront)
	local rot = CFrame.Angles(0, yaw(newFront) - yaw(oldFront), 0)
	return CFrame.new(newCenter) * rot * CFrame.new(-oldCenter)
end

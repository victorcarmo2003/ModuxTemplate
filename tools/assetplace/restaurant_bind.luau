local function point(id)
	return pts:FindFirstChild(id)
end
local function setPoint(id, x, y, z, dir)
	local p = point(id)
	if not p then
		L("[warn] MapPoint " .. id .. " missing")
		return nil
	end
	poseTo(p, face(F(x, y, z), dir), "Point:" .. id)
	return p
end
local function newPoint(id, template, x, y, z, dir)
	local p = point(id)
	if DIFF then
		if p then
			poseTo(p, face(F(x, y, z), dir), "Point:" .. id)
		else
			L("[diff] MapPoint " .. id .. " missing in the place")
		end
		return p
	end
	if not p then
		local tpl = point(template)
		p = tpl:Clone()
		p.Name = id
		p:SetAttribute("PointId", id)
		if p:GetAttribute("NodeId") ~= nil then
			p:SetAttribute("NodeId", id)
		end
		for _, a in { "_RST_OrigCF", "_RST_OrigSize", "_RST_OrigLinks", "_RST_Moved", "Links" } do
			p:SetAttribute(a, nil)
		end
		p:SetAttribute("_RST_Created", true)
		p.Parent = pts
		L("MapPoint created: " .. id)
	end
	local ov = OVERRIDES.External["Point:" .. id]
	p.CFrame = if ov and ov.CF then toCF(ov.CF) else face(F(x, y, z), dir)
	return p
end

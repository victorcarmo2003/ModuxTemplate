-- light zones
local function zone(id, x0, x1, y0, y1, z0, z1)
	local z = zones:FindFirstChild(id)
	if not z then
		L("[warn] LightZone " .. id .. " missing")
		return
	end
	local size = Vector3.new(math.abs(x1 - x0), y1 - y0, math.abs(z1 - z0))
	local cf = CFrame.new(F((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2))
	local ov = OVERRIDES.External["Zone:" .. id]
	if ov then
		cf = if ov.CF then toCF(ov.CF) else cf
		size = if ov.Size then Vector3.new(table.unpack(ov.Size)) else size
	end
	if DIFF then
		EXPECTED["Zone:" .. id] = { inst = z, cf = cf, size = size }
		return
	end
	remember(z)
	z.Size = size
	z.CFrame = cf
end

		sausage = { 128, 0 }, bun = { 0, 0 }, ketchup = { 256, 0 }, mustard = { 384, 0 }, cheese = { 512, 0 },
		bacon = { 640, 0 }, potato_sticks = { 768, 0 }, cream_cheese = { 896, 0 }, coffee = { 0, 128 },
	}
	local function iconGui(part, ing, faceId)
		local g = ensure(part, "Icon", "SurfaceGui")
		g.Face = faceId
		g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		g.PixelsPerStud = 200 -- owner 2026-10-17 (was 80)
		g.LightInfluence = 0.6
		g.Enabled = ART
		local img = ensure(g, "Image", "ImageLabel")
		img.BackgroundTransparency = 1
		img.AnchorPoint = Vector2.new(0.5, 0.5)
		img.Position = UDim2.fromScale(0.5, 0.5)
		img.Size = UDim2.fromScale(0.86, 0.86)
		img.Image = SHEET
		img.ImageRectOffset = Vector2.new(ICON[ing][1], ICON[ing][2])
		img.ImageRectSize = Vector2.new(128, 128)
		img.ScaleType = Enum.ScaleType.Fit
		return g
	end
	local function stroke(textLabel)
		local st = textLabel:FindFirstChild("Stroke") or Instance.new("UIStroke")
		st.Name = "Stroke"
		st.Thickness = 10 -- 3 px at the old 60 PPS = same width in studs at 200 PPS
		st.Color = C.Ink
		st.Parent = textLabel
	end
	local Z_BACK = 72.15
	local Z_SIGN0, Z_SIGN1 = 72.15, 72.25
	-- rev. 4 (2026-10-17): the four units are spread over the WHOLE north wall of the enlarged pantry (X 30.85..49.35, equal
	-- gaps ~1 between units and at the ends), the sauce gondola grows to x0.75 (two columns like the dry one), and the nine
	-- prompts alternate two heights (PROMPT_LO / PROMPT_HI over the floor) so any two are >= 2.5 apart in 3D (min ~2.75).
	local UNITS = { -- name, cached asset, MAP x0 (filled below), uniform scale, header text, header colour
		{ "Freezer", "AST-107_MeatCase", 0, 0.65, "FREEZER", C.Teal },
		{ "Fridge", "AST-030_FridgeDisplayShelves", 0, 0.75, "FRIDGE", Color3.fromRGB(70, 140, 200) },
		{ "DryShelf", "AST-029_GondolaBoxesBare", 0, 0.75, "DRY GOODS", Color3.fromRGB(205, 150, 40) },
		{ "SauceShelf", "AST-029_GondolaBoxesBare", 0, 0.75, "SAUCES", C.Ketchup },
	}
	do
		local WALL_X0, WALL_X1 = 30.85, PX1 - 0.65
		local sizes, sum = {}, 0
		for i, u in UNITS do
			local tpl = CACHE and CACHE:FindFirstChild(u[2])
			local size = if tpl then select(2, tpl:GetBoundingBox()) else Vector3.new(4, 4, 2)
			sizes[i] = size.X * u[4]
			sum += sizes[i]
		end
		local gap = (WALL_X1 - WALL_X0 - sum) / (#UNITS + 1)
		local x = WALL_X0 + gap
		for i, u in UNITS do
			u[3] = x
			x += sizes[i] + gap
		end
	end
	local units = folder(pantry, "StockUnits")
	local U = {} -- unit name -> { x0, x1, cx, cz, front, top, s }
	for _, u in UNITS do
		local name, asset, x0, s, title, color = u[1], u[2], u[3], u[4], u[5], u[6]
		local tpl = CACHE and CACHE:FindFirstChild(asset)
		local size = if tpl then select(2, tpl:GetBoundingBox()) else Vector3.new(4, 4, 2)
		local w, h, d = size.X * s, size.Y * s, size.Z * s
		local cx, cz = x0 + w / 2, Z_BACK + d / 2
		U[name] = { x0 = x0, x1 = x0 + w, cx = cx, cz = cz, front = Z_BACK + d, top = FLOOR + h, s = s }
		local m = packAsset(units, name, asset, face(F(cx, FLOOR, cz), DIR.N), s)
		if m then
			m:SetAttribute("MapId", "STOCK-UNIT-" .. string.upper(name))
			-- AST-030: body and door trim share their outer side / top planes (z-fight); the trim sits 0.005 inside
			local trim = m:FindFirstChild("Fridge_Trim")
			if trim and trim:IsA("BasePart") then
				trim.Size -= Vector3.new(0.01, 0.01, 0)
			end
			local food = m:FindFirstChild("Food")
			if food and food:IsA("BasePart") then -- the meat case's own food: the boxes take its place
				food.Transparency = 1
				food.CanCollide = false
				food.CanQuery = false
			end
		end
		-- blockout stand-in (visible only in a "blockout" run)
		box(units, name .. "_Blk", x0, x0 + w, FLOOR, FLOOR + h, Z_BACK, Z_BACK + d, { Color = C.BlkProp, Transparency = if ART then 1 else 0, CanCollide = not ART, CanQuery = false, CastShadow = false, blk = C.BlkProp })
		local header = box(units, "Header_" .. name, x0 + 0.05, x0 + w - 0.05, 7.35, 8.05, Z_SIGN0, Z_SIGN1, { Color = color, CanCollide = false, CanQuery = false, CastShadow = false, blk = color, art = { Color = color } })
		local hg = label(header, "Label", title, Enum.NormalId.Front, Color3.new(1, 1, 1), nil, Enum.Font.FredokaOne)
		stroke(hg.Text)
	end
	-- items: key, icon, sign text, unit, section x0..x1 (MAP), prompt height, colour, boxes { x0, x1, y0, y1, z0, z1, face },
	-- prompt x (default: section centre)
	local function freezerBoxes(a0, a1)
		local f = U.Freezer
		local y0, y1 = FLOOR + 1.52, FLOOR + 1.80 -- where the case's Food sat (x0.65), under the lid
		local mid = (a0 + a1) / 2
		return {
			{ a0 + 0.08, mid - 0.03, y0, y1, f.cz - 0.5, f.cz + 0.5, Enum.NormalId.Top },
			{ mid + 0.03, a1 - 0.08, y0, y1, f.cz - 0.5, f.cz + 0.5, Enum.NormalId.Top },
		}
	end
	local function fridgeBoxes(a0, a1)
		local f = U.Fridge
		local out = {}
		for _, sy in { 0.91, 2.91, 4.91 } do -- shelf tops of AST-030 (unscaled), boxes 0.02 over them
			local y0 = FLOOR + sy * f.s + 0.02
			table.insert(out, { a0, a1, y0, y0 + 0.55, f.cz - 0.45, f.cz + 0.35, Enum.NormalId.Front })
		end
		return out
	end
	local function gondolaBoxes(unit, col, bw, bh, bd)
		local g = U[unit]
		local out = {}
		for _, sy in { 1.245, 3.885 } do -- shelf tops of AST-029 bare (unscaled)
			local y0 = FLOOR + sy * g.s + 0.02
			local zc = g.cz + 0.54 * g.s
			table.insert(out, { col - bw / 2, col + bw / 2, y0, y0 + bh, zc - bd / 2, zc + bd / 2, Enum.NormalId.Front })
		end
		return out
	end
	local fz, fr, dr, sa = U.Freezer, U.Fridge, U.DryShelf, U.SauceShelf
	local fMid, rMid, sMid = (fz.x0 + fz.x1) / 2, (fr.x0 + fr.x1) / 2, sa.cx
	local col = 0.94 * dr.s / 0.75 -- dry gondola column step (1.25 unscaled)
	local scol = 0.94 * sa.s / 0.75 -- sauce gondola column step
	-- prompt heights over the floor (world Y ~2.25 / ~4.6): low = waist, high = eye level; neighbours alternate
	local LO, HI = 1.8, 4.15
	local ITEMS = {
		{ "pack_sausages", "sausage", "DOGS", "Freezer", fz.x0, fMid, LO, Color3.fromRGB(196, 74, 52), freezerBoxes(fz.x0 + 0.25, fMid) },
		{ "pack_bacon", "bacon", "BACON", "Freezer", fMid, fz.x1, HI, Color3.fromRGB(190, 70, 90), freezerBoxes(fMid, fz.x1 - 0.25) },
		{ "pack_cheese", "cheese", "CHEESE", "Fridge", fr.x0, rMid, LO, Color3.fromRGB(240, 150, 30), fridgeBoxes(fr.x0 + 0.27, rMid - 0.1) },
		{ "pack_cream_cheese", "cream_cheese", "CREAM\nCHEESE", "Fridge", rMid, fr.x1, HI, Color3.fromRGB(70, 140, 200), fridgeBoxes(rMid + 0.1, fr.x1 - 0.27) },
		-- dry: the two low prompts (buns / coffee) sit at the outer edges of their columns so they stay >= 2.5 apart
		{ "pack_buns", "bun", "BUNS", "DryShelf", dr.x0, dr.cx - col / 2, LO, Color3.fromRGB(214, 150, 72), gondolaBoxes("DryShelf", dr.cx - col, 0.8, 1.0, 0.5), dr.x0 + 0.35 },
		{ "pack_potato_sticks", "potato_sticks", "POTATO\nSTICKS", "DryShelf", dr.cx - col / 2, dr.cx + col / 2, HI, Color3.fromRGB(205, 150, 40), gondolaBoxes("DryShelf", dr.cx, 0.8, 1.0, 0.5), dr.cx },
		{ "pack_coffee", "coffee", "COFFEE", "DryShelf", dr.cx + col / 2, dr.x1, LO, Color3.fromRGB(110, 70, 45), gondolaBoxes("DryShelf", dr.cx + col, 0.8, 1.0, 0.5), dr.x1 - 0.35 },
		{ "pack_ketchup", "ketchup", "KETCHUP", "SauceShelf", sa.x0, sMid, HI, C.Ketchup, gondolaBoxes("SauceShelf", sMid - scol, 0.8, 1.0, 0.5), sMid - scol },
		{ "pack_mustard", "mustard", "MUSTARD", "SauceShelf", sMid, sa.x1, LO, Color3.fromRGB(222, 168, 20), gondolaBoxes("SauceShelf", sMid + scol, 0.8, 1.0, 0.5), sMid + scol },
	}
	local bays = folder(pantry, "StockBays")
	local retiredBay = nil
	for _, it in ITEMS do
		local key, ing, text, unitName, x0, x1, promptY, color, packs, promptX = it[1], it[2], it[3], it[4], it[5], it[6], it[7], it[8], it[9], it[10]
		local unit = U[unitName]
		local id = "STOCK-" .. string.upper((string.gsub(key, "^pack_", "")))
		local m = ensure(bays, id, "Model")
		-- rev. 2 shelf pieces (posts, boards, boxes) -> TrailerBackup.Retired, never destroyed
		if not DIFF and not DRY then
			for _, c in m:GetChildren() do
				if c:IsA("BasePart") and (string.match(c.Name, "^Post%d$") or string.match(c.Name, "^Board%d$") or string.match(c.Name, "^Box%d_%d$")) then
					retiredBay = retiredBay or folder(folder(backupRoot(), "Retired"), "StockBays_rev2")
					c:SetAttribute("RetiredFrom", c:GetFullName())
					c.Parent = retiredBay
				end
			end
		end
		m:SetAttribute("MapId", id)
		m:SetAttribute("Package", key)
		m:SetAttribute("Label", (string.gsub(text, "\n", " ")))
		m:SetAttribute("Unit", unitName)
		CS:AddTag(m, "StockShelf")
		-- invisible section volume: hosts the prompt anchor (the unit mesh is the collider)
		local frame = box(m, "Frame", x0 + 0.02, x1 - 0.02, FLOOR, unit.top, Z_BACK, unit.front, { Color = C.Steel, Transparency = if ART then 1 else 0.6, CanCollide = false, CanQuery = false, CastShadow = false, blk = C.BlkProp })
		frame:SetAttribute("Package", key)
		local cx = promptX or (x0 + x1) / 2
		attach(frame, "Prompt_TakeBox", F(cx, FLOOR + promptY, unit.front + 0.5), { Package = key, PromptAction = "take_box" })
		for i, p in packs do
			local pk = box(m, "Pack" .. i, p[1], p[2], p[3], p[4], p[5], p[6], { Color = C.Box, CanCollide = false, CanQuery = false, blk = C.BlkProp, art = { Color = if i % 2 == 1 then C.Box else Color3.fromRGB(184, 126, 82), Material = Enum.Material.Cardboard } })
			iconGui(pk, ing, p[7])
		end
		-- sign on the partition over the unit: icon + name, the xN pill floats over it
		local sign = box(m, "Sign", x0 + 0.05, x1 - 0.05, 6.2, 7.1, Z_SIGN0, Z_SIGN1, { Color = color, CanCollide = false, CanQuery = false, CastShadow = false, blk = color, art = { Color = color } })
		local g = label(sign, "Label", text, Enum.NormalId.Front, Color3.new(1, 1, 1), nil, Enum.Font.FredokaOne)
		g.Enabled = ART
		local t = g.Text
		t.AnchorPoint = Vector2.new(1, 0.5)
		t.Position = UDim2.fromScale(0.97, 0.5)
		t.Size = UDim2.fromScale(0.6, 0.86)
		stroke(t)
		local pad = t:FindFirstChild("Pad")
		if pad then
			pad.Parent = nil -- rev. 2 padding: the text now shares the board with the icon
		end
		local img = ensure(g, "Icon", "ImageLabel")
		img.BackgroundTransparency = 1
		img.AnchorPoint = Vector2.new(0, 0.5)
		img.Position = UDim2.fromScale(0.03, 0.5)
		img.Size = UDim2.fromScale(0.34, 0.86)
		img.Image = SHEET
		img.ImageRectOffset = Vector2.new(ICON[ing][1], ICON[ing][2])
		img.ImageRectSize = Vector2.new(128, 128)
		img.ScaleType = Enum.ScaleType.Fit
	end
	local hide = box(root, "HIDE-P", 25.5, PX1 - 0.5, FLOOR, 8, 72.5, 78.5, { Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false })
	hide:SetAttribute("MapId", "HIDE-P")
	hide:SetAttribute("HideZone", true)
	CS:AddTag(hide, "HideZone")
end

-- 7. lights (kitchen 3 + pantry 1; patio 4 + gate 1; DT 1 = 10, MAP-01 r4 §9) -----------------------------------------------
-- TASK-442 (2026-10-17, owner: "the kitchen got too bright"): the three kitchen lamps at 1.2 / 18 overlapped over the whole
-- room AND LightController added its own fallback (1.6 / 14, shadowed) on LZ-1 because the vehicle had no Light_Interior, so
-- white counters clipped at night. Now: K2 carries the `Light_Interior` fitting (Attachment 0.6 under the lamp, the one
-- shadowed interior light of style guide §5.1): LightController drives it with the trailer switch / blackout and stops
-- making the fallback. K1 / K3 are dimmer warm fill (always lit; the ANM-020 blackout puts them out locally with every other
-- light of the vehicle), pantry lamps dimmer and warmer. Budget: 5 interior lights as before (3 + 2, the fallback is gone).
local WARM = Color3.fromRGB(255, 222, 182)
local function lamp(parent, name, x, y, z, range, brightness, color, fitting, shadows)
	local p = box(parent, name, x - 1.2, x + 1.2, y - 0.08, y, z - 0.4, z + 0.4, { Color = C.Cream, CanCollide = false, CanQuery = false, CastShadow = false, art = { Color = Color3.fromRGB(255, 231, 194), Material = Enum.Material.Neon } })
	local holder = p
	if fitting then
		holder = ensure(p, "Light_Interior", "Attachment")
		holder.CFrame = CFrame.new(0, -0.6, 0)
		local old = p:FindFirstChild("Light")
		if old and old:IsA("PointLight") then
			old.Parent = holder -- the light this snippet made before rev. 5 moves under the fitting (never destroyed)
		end
	end
	local l = ensure(holder, "Light", "PointLight")
	l.Range = range
	l.Brightness = brightness
	l.Color = color or WARM
	l.Shadows = shadows == true
	l.Enabled = ART
	return p
end
lamp(kitchen, "Light_K1", 33, ROOF_Y - 0.1, 63, 13, 0.45, WARM)
lamp(kitchen, "Light_K2", 42.5, ROOF_Y - 0.1, 63, 15, 0.65, Color3.fromRGB(255, 231, 194), true, true)
lamp(kitchen, "Light_K3", 52, ROOF_Y - 0.1, 63, 13, 0.45, WARM)
lamp(pantry, "Light_P", 29.5, P_ROOF_Y - 0.1, 75.4, 10, 0.35, Color3.fromRGB(255, 214, 170))
lamp(pantry, "Light_P2", 42.0, P_ROOF_Y - 0.1, 75.4, 10, 0.35, Color3.fromRGB(255, 214, 170))
-- emergency lamp (TASK-442, Provisional): faint red on the inner east wall of the pantry, the side of the breaker (outside,
-- MAP X 50.25). It lives OUTSIDE the TRL model on purpose: the ANM-020 blackout darkens every light / Neon of the vehicle
-- model, so this is the one interior glow left in the dark (where the players hide). Always on, no shadow; in the lit room
-- the warm lamps wash it out. Counts as 1 local light (style guide §5.1).
do
	local emerg = folder(root, "Emergency")
	emerg:SetAttribute("MapId", "EMERG-P")
	box(emerg, "Housing", 49.22, 49.5, 7.55, 8.15, 74.75, 75.75, { Color = C.SteelDark, CanCollide = false, CanQuery = false, CastShadow = false, art = { Color = Color3.fromRGB(46, 44, 50), Material = Enum.Material.Metal } })
	local lens = box(emerg, "Lens", 49.12, 49.22, 7.65, 8.05, 74.85, 75.65, { Color = Color3.fromRGB(150, 30, 28), CanCollide = false, CanQuery = false, CastShadow = false, art = { Color = Color3.fromRGB(150, 30, 28), Material = Enum.Material.Neon, Transparency = 0.25 } })
	local el = ensure(lens, "Light", "PointLight")
	el.Range = 9
	el.Brightness = 0.35
	el.Color = Color3.fromRGB(255, 52, 44)
	el.Shadows = false
	el.Enabled = ART

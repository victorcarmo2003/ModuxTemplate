-- 11b. owner's hand edits: apply (build) or measure (diff) ------------------------------------------------------------------
-- path of an instance under the restaurant root: names joined by "/", "#n" for the n-th same-named sibling (n > 1)
local function pathOf(inst, top)
	local parts = {}
	local cur = inst
	while cur and cur ~= top do
		local name = cur.Name
		local par = cur.Parent
		if par then
			local n = 0
			for _, sib in par:GetChildren() do
				if sib.Name == name and sib.ClassName == cur.ClassName then
					n += 1
				end
				if sib == cur then
					break
				end
			end
			if n > 1 then
				name = name .. "#" .. n
			end
		end
		table.insert(parts, 1, name)
		cur = par
	end
	return table.concat(parts, "/")
end
local function index(top)
	local map = {}
	for _, d in top:GetDescendants() do
		-- 2026-10-17 (TASK-441): lights and SurfaceGuis too, so the owner's Brightness / Range / PixelsPerStud edits are diffed
		if d:IsA("BasePart") or d:IsA("Attachment") or d:IsA("Model") or d:IsA("Folder") or d:IsA("Light") or d:IsA("SurfaceGui") then
			map[pathOf(d, top)] = d
		end
	end
	return map
end
local function cfList(cf)
	local t = { cf:GetComponents() }
	for i, v in t do
		t[i] = math.floor(v * 10000 + 0.5) / 10000
	end
	return t
end
do
	local map = nil
	local applied = 0
	for path, ov in OVERRIDES.Parts do
		map = map or index(root)
		local inst = map[path]
		if inst then
			if ov.Deleted then
				inst.Parent = nil -- the owner deleted this generated piece
			elseif inst:IsA("BasePart") then
				if ov.CF then
					inst.CFrame = toCF(ov.CF)
				end
				if ov.Size then
					inst.Size = Vector3.new(table.unpack(ov.Size))
				end
				if ov.Color then
					inst.Color = Color3.fromRGB(table.unpack(ov.Color))
				end
				if ov.Material then
					inst.Material = Enum.Material[ov.Material]
				end
				if ov.Transparency then
					inst.Transparency = ov.Transparency
				end
				if ov.CanCollide ~= nil then
					inst.CanCollide = ov.CanCollide
				end
			elseif inst:IsA("Attachment") and ov.CF then
				inst.CFrame = toCF(ov.CF)
			elseif inst:IsA("Light") then
				if ov.Brightness then
					inst.Brightness = ov.Brightness
				end
				if ov.Range then
					inst.Range = ov.Range
				end
				if ov.Color then
					inst.Color = Color3.fromRGB(table.unpack(ov.Color))
				end
				if ov.Shadows ~= nil then
					inst.Shadows = ov.Shadows
				end
				if ov.Enabled ~= nil then
					inst.Enabled = ov.Enabled
				end
				if ov.Angle and (inst:IsA("SpotLight") or inst:IsA("SurfaceLight")) then
					inst.Angle = ov.Angle
				end
				if ov.Face and (inst:IsA("SpotLight") or inst:IsA("SurfaceLight")) then
					inst.Face = Enum.NormalId[ov.Face]
				end
			elseif inst:IsA("SurfaceGui") then
				if ov.SizingMode then
					inst.SizingMode = Enum.SurfaceGuiSizingMode[ov.SizingMode]
				end
				if ov.PixelsPerStud then
					inst.PixelsPerStud = ov.PixelsPerStud
				end
				if ov.CanvasSize then
					inst.CanvasSize = Vector2.new(table.unpack(ov.CanvasSize))
				end
				if ov.Face then
					inst.Face = Enum.NormalId[ov.Face]
				end
				if ov.LightInfluence then
					inst.LightInfluence = ov.LightInfluence
				end
				if ov.GuiBrightness then
					inst.Brightness = ov.GuiBrightness
				end
				if ov.AlwaysOnTop ~= nil then
					inst.AlwaysOnTop = ov.AlwaysOnTop
				end
				if ov.Enabled ~= nil then
					inst.Enabled = ov.Enabled
				end
			end
			applied += 1
		end
	end
	if applied > 0 then
		L("owner overrides applied: " .. applied)
	end
end
if DIFF then
	-- compare the scratch build with the live restaurant
	local want, have = index(root), index(live)
	local out, diffs, nDel, nNew, nChg = {}, {}, 0, 0, 0
	local function near(a, b, tol)
		return math.abs(a - b) <= tol
	end
	-- TrailerDeco is built once and then belongs to the owner (he regrouped the string lights in Models, 2026-10-17): skipped
	local function ownerManaged(path)
		return string.find(path, "^TRL/Front/TrailerDeco/") ~= nil
	end
	for path, w in want do
		local h = have[path]
		if ownerManaged(path) then
			continue
		end
		if not h then
			nDel += 1
			table.insert(diffs, string.format('\t\t[%q] = { Deleted = true },', path))
			table.insert(out, "DELETED " .. path)
		elseif w:IsA("BasePart") and h:IsA("BasePart") then
			local e = {}
			local pw, ph = w.CFrame, h.CFrame
			if (pw.Position - ph.Position).Magnitude > 0.01 or (pw.LookVector - ph.LookVector).Magnitude > 0.002 or (pw.UpVector - ph.UpVector).Magnitude > 0.002 then
				table.insert(e, "CF = {" .. table.concat(cfList(ph), ", ") .. "}")
			end
			if (w.Size - h.Size).Magnitude > 0.01 then
				table.insert(e, string.format("Size = {%.4f, %.4f, %.4f}", h.Size.X, h.Size.Y, h.Size.Z))
			end
			local cw, ch = w.Color, h.Color
			if not (near(cw.R, ch.R, 0.006) and near(cw.G, ch.G, 0.006) and near(cw.B, ch.B, 0.006)) then
				table.insert(e, string.format("Color = {%d, %d, %d}", math.floor(ch.R * 255 + 0.5), math.floor(ch.G * 255 + 0.5), math.floor(ch.B * 255 + 0.5)))
			end
			if w.Material ~= h.Material then
				table.insert(e, string.format("Material = %q", h.Material.Name))
			end
			if not near(w.Transparency, h.Transparency, 0.001) then
				table.insert(e, string.format("Transparency = %.3f", h.Transparency))
			end
			if w.CanCollide ~= h.CanCollide then
				table.insert(e, "CanCollide = " .. tostring(h.CanCollide))
			end
			if #e > 0 then
				nChg += 1
				table.insert(diffs, string.format("\t\t[%q] = { %s },", path, table.concat(e, ", ")))
				table.insert(out, string.format("CHANGED %s d=%.2f rot=%.3f size=%s :: %s", path, (pw.Position - ph.Position).Magnitude, (pw.LookVector - ph.LookVector).Magnitude, tostring(w.Size), table.concat(e, ", "):sub(1, 120)))
			end
		elseif w:IsA("Attachment") and h:IsA("Attachment") then
			if (w.WorldPosition - h.WorldPosition).Magnitude > 0.01 and (w.CFrame.Position - h.CFrame.Position).Magnitude > 0.01 then
				nChg += 1
				table.insert(diffs, string.format("\t\t[%q] = { CF = {%s} },", path, table.concat(cfList(h.CFrame), ", ")))
				table.insert(out, string.format("CHANGED (attachment) %s dLocal=%.2f", path, (w.CFrame.Position - h.CFrame.Position).Magnitude))
			end
		elseif w:IsA("Light") and h:IsA("Light") then
			local e = {}
			if not near(w.Brightness, h.Brightness, 0.005) then
				table.insert(e, string.format("Brightness = %.3f", h.Brightness))
			end
			if not near(w.Range, h.Range, 0.01) then
				table.insert(e, string.format("Range = %.2f", h.Range))
			end
			local cw, ch = w.Color, h.Color
			if not (near(cw.R, ch.R, 0.006) and near(cw.G, ch.G, 0.006) and near(cw.B, ch.B, 0.006)) then
				table.insert(e, string.format("Color = {%d, %d, %d}", math.floor(ch.R * 255 + 0.5), math.floor(ch.G * 255 + 0.5), math.floor(ch.B * 255 + 0.5)))
			end
			if w.Shadows ~= h.Shadows then
				table.insert(e, "Shadows = " .. tostring(h.Shadows))
			end
			if w.Enabled ~= h.Enabled then
				table.insert(e, "Enabled = " .. tostring(h.Enabled))
			end
			if (h:IsA("SpotLight") or h:IsA("SurfaceLight")) and w.ClassName == h.ClassName then
				if not near(w.Angle, h.Angle, 0.01) then
					table.insert(e, string.format("Angle = %.2f", h.Angle))
				end
				if w.Face ~= h.Face then
					table.insert(e, string.format("Face = %q", h.Face.Name))
				end
			end
			if #e > 0 then
				nChg += 1
				table.insert(diffs, string.format("\t\t[%q] = { %s },", path, table.concat(e, ", ")))
				table.insert(out, string.format("CHANGED (light) %s :: %s", path, table.concat(e, ", ")))
			end
		elseif w:IsA("SurfaceGui") and h:IsA("SurfaceGui") then
			local e = {}
			if w.SizingMode ~= h.SizingMode then
				table.insert(e, string.format("SizingMode = %q", h.SizingMode.Name))
			end
			if not near(w.PixelsPerStud, h.PixelsPerStud, 0.01) then
				table.insert(e, string.format("PixelsPerStud = %.2f", h.PixelsPerStud))
			end
			if h.SizingMode == Enum.SurfaceGuiSizingMode.FixedSize and (w.CanvasSize - h.CanvasSize).Magnitude > 0.5 then
				table.insert(e, string.format("CanvasSize = {%d, %d}", h.CanvasSize.X, h.CanvasSize.Y))
			end
			if w.Face ~= h.Face then
				table.insert(e, string.format("Face = %q", h.Face.Name))
			end
			if not near(w.LightInfluence, h.LightInfluence, 0.005) then
				table.insert(e, string.format("LightInfluence = %.3f", h.LightInfluence))
			end
			if not near(w.Brightness, h.Brightness, 0.005) then
				table.insert(e, string.format("GuiBrightness = %.3f", h.Brightness))
			end
			if w.AlwaysOnTop ~= h.AlwaysOnTop then
				table.insert(e, "AlwaysOnTop = " .. tostring(h.AlwaysOnTop))
			end
			if w.Enabled ~= h.Enabled then
				table.insert(e, "Enabled = " .. tostring(h.Enabled))
			end
			if #e > 0 then
				nChg += 1
				table.insert(diffs, string.format("\t\t[%q] = { %s },", path, table.concat(e, ", ")))
				table.insert(out, string.format("CHANGED (gui) %s :: %s", path, table.concat(e, ", ")))
			end
		end
	end
	for path, h in have do
		if not want[path] and not ownerManaged(path) and (h:IsA("BasePart") or h:IsA("Model") or h:IsA("Light") or h:IsA("SurfaceGui")) then
			-- only report the top of a new subtree
			local par = h.Parent
			if par == live or want[pathOf(par, live)] then
				nNew += 1
				table.insert(out, "NEW (kept as is) " .. path .. " [" .. h.ClassName .. "]")
			end
		end
	end
	local ext = {}
	for key, e in EXPECTED do
		local inst = e.inst
		if e.links then
			table.insert(ext, string.format("\t\t[%q] = %q,", key, tostring(inst:GetAttribute("Links") or "")))
			table.insert(out, "EXTERNAL links " .. key)
		else
			local cur = if inst:IsA("Model") then inst:GetPivot() else inst.CFrame
			local moved = (cur.Position - e.cf.Position).Magnitude > 0.01 or (cur.LookVector - e.cf.LookVector).Magnitude > 0.002
			local sized = e.size and inst:IsA("BasePart") and (inst.Size - e.size).Magnitude > 0.01
			if moved or sized then
				local t = { "CF = {" .. table.concat(cfList(cur), ", ") .. "}" }
				if sized then
					table.insert(t, string.format("Size = {%.4f, %.4f, %.4f}", inst.Size.X, inst.Size.Y, inst.Size.Z))
				end
				table.insert(ext, string.format("\t\t[%q] = { %s },", key, table.concat(t, ", ")))
				table.insert(out, "EXTERNAL " .. key .. string.format(" moved %.2f", (cur.Position - e.cf.Position).Magnitude))
			end
		end
	end
	table.sort(diffs)
	table.sort(ext)
	local text = "local OVERRIDES = {\n\tParts = {\n" .. table.concat(diffs, "\n") .. "\n\t},\n\tExternal = {\n" .. table.concat(ext, "\n") .. "\n\t},\n}"
	local sv = SS:FindFirstChild("_RST_DiffOut") or Instance.new("StringValue")
	sv.Name = "_RST_DiffOut"
	sv.Value = text
	sv.Parent = SS
	local rep = SS:FindFirstChild("_RST_DiffReport") or Instance.new("StringValue")
	rep.Name = "_RST_DiffReport"
	table.sort(out)
	rep.Value = table.concat(out, "\n")
	rep.Parent = SS
	root:Destroy() -- scratch build
	return string.format("diff: %d changed, %d deleted, %d new, %d external (ServerStorage._RST_DiffOut / _RST_DiffReport)\n", nChg, nDel, nNew, #ext) .. table.concat(log, "\n")
end

-- 12. checks ----------------------------------------------------------------------------------------------------------------
do
	local anchors = {}
	for _, a in CS:GetTagged("Interactable") do
		if a:IsDescendantOf(trl) then
			table.insert(anchors, a)
		end
	end
	local function owner(a)
		local p = a.Parent
		while p and p ~= trl do
			if CS:HasTag(p, "Station") or (p:IsA("Model") and p.Parent and (p.Parent == kitchen or p.Parent == front)) then
				return p
			end
			p = p.Parent
		end
		return a.Parent
	end
	local function pos(a)
		return if a:IsA("Attachment") then a.WorldPosition else a.Position
	end
	local close = 0
	for i = 1, #anchors do
		for j = i + 1, #anchors do
			local a, b = anchors[i], anchors[j]
			local oa, ob = owner(a), owner(b)
			if oa ~= ob then
				local d = (pos(a) - pos(b)).Magnitude
				local gap = if a.Name == "Prompt_Answer" or b.Name == "Prompt_Answer" then 1.0 else 2.5
				if d < gap then
					close += 1
					if close <= 12 then
						L(string.format("[gap] %s/%s - %s/%s %.2f", oa.Name, a.Name, ob.Name, b.Name, d))
					end
				end
			end
		end
	end
	L("anchors in TRL: " .. #anchors .. ", pairs under the gap: " .. close)
	local kinds = {}
	for _, s in CS:GetTagged("Station") do
		if s:IsDescendantOf(trl) then
			local k = tostring(s:GetAttribute("StationKind"))
			kinds[k] = (kinds[k] or 0) + 1
		end
	end
	local ks = {}
	for k, v in kinds do
		table.insert(ks, k .. "=" .. v)
	end
	table.sort(ks)
	L("stations: " .. table.concat(ks, " "))
	local vehicles = 0
	for _, m in CS:GetTagged("Vehicle") do
		if m:IsDescendantOf(workspace) and m:GetAttribute("Vehicle") == "trailer" then
			vehicles += 1
		end
	end
	L("Vehicle trailer models in the Workspace: " .. vehicles .. " (need 1)")
	local ghost = 0
	for _, tag in TAGS_OFF do
		for _, i in CS:GetTagged(tag) do
			if i:IsDescendantOf(SS) then
				ghost += 1
			end
		end
	end
	L("gameplay tags left in ServerStorage: " .. ghost)
end


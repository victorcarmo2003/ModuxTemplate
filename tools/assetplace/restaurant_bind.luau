-- clear walkway X 25.5..32 from one door to the other, shelves on the partition and the south wall (aisle ~4), DROP-R under the
-- loading hatch on the south wall (raised, rev. 4; the DOGS / BUNS / MUSTARD crates moved outside), HIDE-P over the whole room.
-- Doors (2026-10-17 rev. 2): CLOSED by default, AutoDoor (src/Door/client/DoorController.luau) DOOR-P swings on its MAP-west edge
-- (world +X = "Right" for these unrotated parts) and stops at 75 degrees so, opened into the kitchen, it misses the journal
-- tablet on the kitchen west wall. DOOR-B is a POCKET door (DoorSlide = -4.9, world -X = MAP east, into the solid wall X 32..37):
-- a swing leaf either crossed the pantry aisle (inward, hinge east) or the sidewalk toward the Mart (outward, hinge west), and
-- the controller swings away from whoever comes, so it cannot be told "inward only" (R6 sweep, 2026-10-17). Every piece of a leaf (window, band, lock) is a part of the
-- door Model with DoorLeaf = true, so the controller moves them together (no welds). Server leaves are CanCollide false
-- (NPCs walk through, DoorController contract); DoorOrigCanCollide records the intent.
local function doorModel(folderInst, name, x0, x1, zc, angle, mapId, lockId, hingeEast, slide)
	-- old flat-open leaves of rev. 1 (loose Parts named like the door) -> TrailerBackup.Retired
	for _, n in { name, name .. "_Window", name .. "_Band", name .. "_Lock" } do
		for _, c in folderInst:GetChildren() do
			if c.Name == n and c:IsA("BasePart") and not DIFF then
				c:SetAttribute("RetiredFrom", c:GetFullName())
				c.Parent = folder(backupRoot(), "Retired")
			end
		end
	end
	local m = ensure(folderInst, name, "Model")
	local t = 0.16
	local function piece(n, px0, px1, y0, y1, dz, color, mat, tr)
		local p = box(m, n, px0, px1, y0, y1, zc - dz, zc + dz, { Color = color, CanCollide = false, CanQuery = n == "Leaf", blk = C.BlkProp, art = { Color = color, Material = mat or Enum.Material.SmoothPlastic, Transparency = tr or 0 } })
		p:SetAttribute("DoorLeaf", true)
		p:SetAttribute("DoorOrigCanCollide", n == "Leaf")
		return p
	end
	-- hinge at x0 (MAP west, world +X = "Right") or at x1 (hingeEast, "Left"); window and lock at the free edge. The leaf
	-- stops at Y FLOOR + 7.8, under the steel head (8.3)
	local hx, fx0, fx1 = x0, x1 - 1.3, x1 - 0.6
	if hingeEast then
		hx, fx0, fx1 = x1, x0 + 0.3, x0 + 0.2
	end
	local leaf = piece("Leaf", x0, x1, FLOOR + 0.05, FLOOR + 7.8, t / 2, C.Cream)
	piece("Window", fx0, fx0 + 1.0, FLOOR + 5.2, FLOOR + 6.0, t / 2 + 0.03, C.Ink, Enum.Material.Glass, 0.2)
	piece("Band", x0 + 0.1, x1 - 0.1, FLOOR + 2.0, FLOOR + 2.4, t / 2 + 0.03, C.Ketchup)
	local lock = piece("Lock", fx1, fx1 + 0.4, FLOOR + 3.6, FLOOR + 4.1, t / 2 + 0.09, C.Mustard)
	leaf:SetAttribute("MapId", mapId)
	lock:SetAttribute("MapId", lockId)
	attach(leaf, "Door_Hinge", F(hx, FLOOR + 0.05, zc))
	m:SetAttribute("MapId", mapId)
	m:SetAttribute("DoorId", mapId)
	m:SetAttribute("DoorHinge", if slide then nil elseif hingeEast then "Left" else "Right")
	m:SetAttribute("DoorAngle", if slide then nil else angle)
	m:SetAttribute("DoorSlide", slide)
	m:SetAttribute("DoorRadius", 7)
	CS:AddTag(m, "AutoDoor")
	return m
end

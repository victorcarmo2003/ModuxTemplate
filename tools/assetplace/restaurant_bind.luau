-- backup ---------------------------------------------------------------------------------------------------------------
local function backupRoot()
	local f = SS:FindFirstChild(BK_NAME)
	if not f and not DRY then
		f = Instance.new("Folder")
		f.Name = BK_NAME
		f:SetAttribute("Task", "TASK-382 restaurant_bind")
		f.Parent = SS
	end
	return f
end
local function indexFolder()
	local bk = backupRoot()
	local idx = bk:FindFirstChild("_Index")
	if not idx then
		idx = Instance.new("Folder")
		idx.Name = "_Index"
		idx.Parent = bk
	end
	return idx
end
local function strip(inst)
	local tags = CS:GetTags(inst)
	if #tags == 0 then
		return
	end
	if inst:GetAttribute("OrigTags") == nil then
		inst:SetAttribute("OrigTags", table.concat(tags, ","))
	end
	for _, tag in tags do
		if table.find(TAGS_OFF, tag) then
			CS:RemoveTag(inst, tag)
		end
	end
end
local function neutralize(root)
	strip(root)
	for _, d in root:GetDescendants() do
		strip(d)
	end
end
local function restoreTags(root)
	local function one(inst)
		local s = inst:GetAttribute("OrigTags")
		if typeof(s) == "string" then
			for tag in string.gmatch(s, "[^,]+") do
				CS:AddTag(inst, tag)
			end
			inst:SetAttribute("OrigTags", nil)
		end
	end
	one(root)
	for _, d in root:GetDescendants() do
		one(d)
	end
end
-- moves inst into the backup, mirroring its path; records the parent for undo
local function toBackup(inst, why)
	if DIFF or not inst or not inst.Parent or inst:IsDescendantOf(SS) then
		return false
	end
	if DRY then
		L("[dry] backup " .. inst:GetFullName() .. " (" .. why .. ")")
		return true
	end
	local bk = backupRoot()
	local folder = bk
	-- mirror the ancestor chain under the backup (Workspace/MAP01_Assets/...)
	local chain = {}
	local p = inst.Parent
	while p and p ~= game do
		table.insert(chain, 1, p.Name)
		p = p.Parent
	end
	for _, name in chain do
		local nxt = folder:FindFirstChild(name)
		if not nxt then
			nxt = Instance.new("Folder")
			nxt.Name = name
			nxt.Parent = folder
		end
		folder = nxt
	end
	local ov = Instance.new("ObjectValue")
	ov.Name = inst.Name
	ov.Value = inst
	ov:SetAttribute("OrigPath", inst:GetFullName())
	ov:SetAttribute("Why", why)
	local par = Instance.new("ObjectValue")
	par.Name = "Parent"
	par.Value = inst.Parent
	par.Parent = ov
	ov.Parent = indexFolder()
	inst:SetAttribute("OrigPath", inst:GetFullName())
	neutralize(inst)
	inst.Parent = folder
	L("backup: " .. inst:GetAttribute("OrigPath") .. " (" .. why .. ")")
	return true
end

-- first pose of a reused instance (undo returns to it)
local function remember(inst)
	if DIFF or inst:GetAttribute("_RST_OrigCF") ~= nil then
		return
	end
	local cf = if inst:IsA("Model") then inst:GetPivot() elseif inst:IsA("BasePart") then inst.CFrame else nil
	if cf then
		inst:SetAttribute("_RST_OrigCF", cf)
	end
	if inst:IsA("BasePart") then
		inst:SetAttribute("_RST_OrigSize", inst.Size)
	end
	if inst:GetAttribute("Links") ~= nil then
		inst:SetAttribute("_RST_OrigLinks", inst:GetAttribute("Links"))
	end
	inst:SetAttribute("_RST_Moved", true)
end
local EXPECTED = {} -- diff mode: key -> { inst, cf }
local function poseTo(inst, cf, key)
	local ov = key and OVERRIDES.External[key]
	if ov and ov.CF then
		cf = toCF(ov.CF)
	end
	if DIFF then
		if key then
			EXPECTED[key] = { inst = inst, cf = cf }
		end
		return
	end
	remember(inst)
	if inst:IsA("Model") then
		inst:PivotTo(cf)
	else
		inst.CFrame = cf
	end
end

-- builders -------------------------------------------------------------------------------------------------------------
local function ensure(parent, name, class)
	local x = parent:FindFirstChild(name)
	if x and x.ClassName ~= class then
		x = nil
	end
	if not x then
		x = Instance.new(class)
		x.Name = name
		x.Parent = parent
	end
	return x
end
local function folder(parent, name)
	return ensure(parent, name, "Folder")
end
local function styled(p, props)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.CastShadow = true
	p.CanCollide = true
	p.CanQuery = true
	p.CanTouch = false
	p.Transparency = 0
	for k, v in props or {} do
		if k ~= "art" and k ~= "blk" then
			p[k] = v
		end
	end
	local art = props and props.art
	if ART and art then
		for k, v in art do
			p[k] = v
		end
	elseif not ART and props and props.blk then
		p.Color = props.blk
		p.Material = Enum.Material.SmoothPlastic
	end
	p:SetAttribute("RST", true)
	return p
end
-- axis-aligned box from MAP bounds
local function box(parent, name, x0, x1, y0, y1, z0, z1, props)
	local p = ensure(parent, name, "Part")
	p.Shape = Enum.PartType.Block
	p.Size = Vector3.new(math.abs(x1 - x0), y1 - y0, math.abs(z1 - z0))
	p.CFrame = CFrame.new(F((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2))
	return styled(p, props)
end
-- cylinder standing up, centre (x, y, z) MAP, diameter d, height h
local function cyl(parent, name, x, y, z, d, h, props)
	local p = ensure(parent, name, "Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(h, d, d)
	p.CFrame = CFrame.new(F(x, y, z)) * CFrame.Angles(0, 0, math.rad(90))
	return styled(p, props)
end
-- cylinder lying along MAP X
local function rodX(parent, name, x0, x1, y, z, d, props)
	local p = ensure(parent, name, "Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(math.abs(x1 - x0), d, d)
	p.CFrame = CFrame.new(F((x0 + x1) / 2, y, z))
	return styled(p, props)
end
local function attach(parent, name, worldPos, attrs, tags)
	local a = ensure(parent, name, "Attachment")
	a.WorldCFrame = CFrame.new(worldPos)
	for k, v in attrs or {} do
		a:SetAttribute(k, v)
	end
	for _, t in tags or {} do
		CS:AddTag(a, t)
	end
	return a
end
local function texture(part, name, id, face, studs, color, transparency, z)
	if not ART then
		local t = part:FindFirstChild(name)
		if t then
			t.Transparency = 1
		end
		return
	end
	local t = ensure(part, name, "Texture")
	t.Texture = id
	t.Face = face or Enum.NormalId.Top
	t.StudsPerTileU = studs
	t.StudsPerTileV = studs
	t.Color3 = color or Color3.new(1, 1, 1)
	t.Transparency = transparency or 0
	t.ZIndex = z or 1
	return t
end
local function label(part, name, text, face, textColor, bg, font)
	local g = ensure(part, name, "SurfaceGui")
	g.Face = face or Enum.NormalId.Front
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 200 -- owner 2026-10-17: sharper signs (was 60)
	g.LightInfluence = 0.6
	g.Enabled = ART
	local l = ensure(g, "Text", "TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = if bg then 0 else 1
	l.BackgroundColor3 = bg or Color3.new(1, 1, 1)
	l.Text = text
	l.TextScaled = true
	l.Font = font or Enum.Font.FredokaOne
	l.TextColor3 = textColor or C.Ink
	return g
end
local CACHE = SS:FindFirstChild("__AssetCache")
-- clone of a pack asset (ServerStorage.__AssetCache), base centre at pos, front (LookVector) = dir, optional size per part
local function packAsset(parent, name, asset, cf, scale)
	local m = parent:FindFirstChild(name)
	if not ART then
		if m then
			m.Parent = nil -- art layer only; a blockout run hides it (kept in memory, rebuilt by apply)
		end
		return nil
	end
	if not m then
		local tpl = CACHE and CACHE:FindFirstChild(asset)
		if not tpl then
			L("[warn] __AssetCache." .. asset .. " missing; " .. name .. " stays blockout")
			return nil
		end
		m = tpl:Clone()
		m.Name = name
		m:SetAttribute("Asset", asset)
		m:SetAttribute("RST", true)
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		m.Parent = parent
	end
	if scale then
		local s = if typeof(scale) == "number" then Vector3.new(scale, scale, scale) else scale
		local pivot = m:GetPivot()
		local tpl = CACHE and CACHE:FindFirstChild(asset)
		if tpl then
			local tp = tpl:GetPivot()
			for _, d in m:GetDescendants() do
				if d:IsA("BasePart") then
					local src = tpl:FindFirstChild(d.Name, true)
					if src and src:IsA("BasePart") then
						local rel = tp:ToObjectSpace(src.CFrame)
						d.Size = src.Size * s
						d.CFrame = pivot * CFrame.new(rel.Position * s) * (rel - rel.Position)
					end
				end
			end
		end
	end
	m:PivotTo(cf)
	return m
end


--!nonstrict
--[[
	texture_lobby.luau (owner request 2026-10-12: "give the lobby a texture pass": floor and many surfaces were flat lilac/white).
	Edit-mode snippet for Studio, NOT gameplay code. Paste in the command bar / run by hand. NEVER Place.run.
	Only ADDS child Texture instances (names TexLobby_*) and one Part (TexLobby_FoodDeck). Geometry, colours, materials,
	MeshIds, lights, neon, zones, water and facades (Kenney meshes with their own atlas) are not touched.
	Idempotent: every run destroys the TexLobby_* it made earlier and rebuilds them. UNDO = true removes everything.

	  1. LobbyFloor (Kenney sidewalk meshes): warm grey-beige paving (T_LobbyPave, 8 studs/tile = 2 x 2 slabs of 4 studs,
	     visible joints) + a transparent stain overlay (T_LobbyStain, 24 studs/tile, ZIndex above). Top face only.
	  2. Apron_Classes / Apron_Shop / Apron_Codes: lighter paving (T_LobbyPaveLight) so the queue aprons still read as "special"
	     ground; their neon edge strips stay the semantic colour.
	  3. Stage_Top: wood planks (T_LobbyWood). Stage_Body (red): brick (T_LobbyBrick) tinted with the part Color3 on the 4 side
	     faces, so it stays Ketchup red.
	  4. Food court: wood deck (new Part TexLobby_FoodDeck, non-colliding, 0.08 thick) under the picnic tables M1..M3.
	Textures are original work generated by tools/assetplace/gen_lobby_textures.py (no third-party source). Not touched:
	road (own asphalt texture), squad pads / medallion / chevrons (semantic cylinders), fountain / water, light pools, signs.

	Tiling scale: TILE_PAVE (6..10 studs). Returns a log string.
]]

local UNDO = false
local TILE_PAVE = 8 -- studs per tile of the paving (2 x 2 slabs)
local TILE_STAIN = 24
local TILE_WOOD = 6
local TILE_BRICK = 5

local IDS = {
	Pave = "rbxassetid://106237538351376",
	PaveLight = "rbxassetid://119408403372428",
	Stain = "rbxassetid://116968848192402",
	Wood = "rbxassetid://80430039847457",
	Brick = "rbxassetid://84014969468829",
}

local lobby = workspace:FindFirstChild("LOBBY_Assets")
if not lobby then
	return "[err] no workspace.LOBBY_Assets"
end
local log = {}

local function clear(root: Instance): number
	local n = 0
	for _, d in root:GetDescendants() do
		if string.sub(d.Name, 1, 9) == "TexLobby_" then
			d:Destroy()
			n += 1
		end
	end
	return n
end

local function addTexture(part: BasePart, name: string, id: string, face: Enum.NormalId, studs: number, z: number, color: Color3?)
	local t = Instance.new("Texture")
	t.Name = name
	t.Texture = id
	t.Face = face
	t.StudsPerTileU = studs
	t.StudsPerTileV = studs
	t.ZIndex = z
	if color then
		t.Color3 = color
	end
	t.Parent = part
	part:SetAttribute("TexLobbyApplied", true)
end

local removed = clear(lobby)
table.insert(log, "removed previous: " .. removed)
if UNDO then
	for _, d in lobby:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("TexLobbyApplied") then
			d:SetAttribute("TexLobbyApplied", nil)
		end
	end
	return table.concat(log, "\n")
end

-- 1. floor
local nFloor = 0
local floorFolder = lobby:FindFirstChild("LobbyFloor", true)
for _, d in (if floorFolder then floorFolder:GetDescendants() else {}) do
	if d:IsA("MeshPart") then
		addTexture(d, "TexLobby_Pave", IDS.Pave, Enum.NormalId.Top, TILE_PAVE, 1, nil)
		addTexture(d, "TexLobby_Stain", IDS.Stain, Enum.NormalId.Top, TILE_STAIN, 2, nil)
		nFloor += 1
	end
end
table.insert(log, "floor tiles: " .. nFloor)

-- 2..3. procedural parts by name
local proc = lobby:FindFirstChild("LobbyProcedural", true)
local function byName(n: string): BasePart?
	local p = proc and proc:FindFirstChild(n)
	return p and p:IsA("BasePart") and p or nil
end
for _, n in { "Apron_Classes", "Apron_Shop", "Apron_Codes" } do
	local p = byName(n)
	if p then
		addTexture(p, "TexLobby_Pave", IDS.PaveLight, Enum.NormalId.Top, TILE_PAVE, 1, nil)
		table.insert(log, n .. ": paving (light)")
	end
end
local top = byName("Stage_Top")
if top then
	addTexture(top, "TexLobby_Wood", IDS.Wood, Enum.NormalId.Top, TILE_WOOD, 1, nil)
	table.insert(log, "Stage_Top: wood")
end
local body = byName("Stage_Body")
if body then
	for _, f in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
		addTexture(body, "TexLobby_Brick" .. f.Name, IDS.Brick, f, TILE_BRICK, 1, body.Color)
	end
	table.insert(log, "Stage_Body: brick tinted " .. tostring(body.Color))
end

-- 4. food court deck under the picnic tables M1..M3
local fc = lobby:FindFirstChild("LobbyFoodCourt", true)
if fc then
	local minV, maxV
	for _, m in fc:GetChildren() do
		if string.find(m.Name, "LB-PICNIC-M", 1, true) and m:IsA("Model") then
			local cf, sz = m:GetBoundingBox()
			local lo = Vector3.new(cf.X - sz.X / 2, 0, cf.Z - sz.Z / 2)
			local hi = Vector3.new(cf.X + sz.X / 2, 0, cf.Z + sz.Z / 2)
			minV = minV and Vector3.new(math.min(minV.X, lo.X), 0, math.min(minV.Z, lo.Z)) or lo
			maxV = maxV and Vector3.new(math.max(maxV.X, hi.X), 0, math.max(maxV.Z, hi.Z)) or hi
		end
	end
	if minV and maxV then
		local margin = 3
		local size = Vector3.new(maxV.X - minV.X + 2 * margin, 0.08, maxV.Z - minV.Z + 2 * margin)
		local deck = Instance.new("Part")
		deck.Name = "TexLobby_FoodDeck"
		deck.Anchored = true
		deck.CanCollide = false
		deck.CanQuery = false
		deck.CanTouch = false
		deck.CastShadow = false
		deck.Material = Enum.Material.SmoothPlastic
		deck.Color = Color3.fromRGB(255, 255, 255)
		deck.Size = size
		deck.Position = Vector3.new((minV.X + maxV.X) / 2, 0.03, (minV.Z + maxV.Z) / 2)
		deck.Parent = fc
		addTexture(deck, "TexLobby_Wood", IDS.Wood, Enum.NormalId.Top, TILE_WOOD, 1, nil)
		table.insert(log, string.format("food deck %.1f x %.1f at (%.1f, %.1f)", size.X, size.Z, deck.Position.X, deck.Position.Z))
	end
end
return table.concat(log, "\n")

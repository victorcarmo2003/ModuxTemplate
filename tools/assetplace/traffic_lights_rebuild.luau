--!nonstrict
--[[
	traffic_lights_rebuild.luau (owner request 2026-10-12; Provisional). Edit-mode Studio snippet, NOT gameplay code.
	Idempotent, surgical, NO Place.run, nothing is deleted (what it replaces goes to ServerStorage.TrafficLights_Backup).

	The street lights live in workspace.MAP01_Assets.TrafficLights (4 poles Signal_WB / EB / NB / SB; SignalHead tagged
	TrafficSignal and PedSignal tagged PedSignal, attribute Axis = EW | NS, lamps Red Yellow Green / Walk Hand with
	OnColor). The cycle itself is code now: src/Traffic/client/TrafficLightController (Content.TrafficLights).
	This snippet rebuilds the folder after a Place.run from a mirror read from the Studio:
	tools/assetplace/data/traffic_lights.luau (MAP coordinates: world = (-x, y, 67.887287 - z), rotation turned 180 deg
	around Y; the same formula goes both ways).

	Modes (argument of run("traffic_lights_rebuild", mode)):
	  "capture"      reads the live folder and RETURNS the mirror source (save it as data/traffic_lights.luau). No change.
	  "dry" (default) reports what "apply" would create / tag / set. No change.
	  "apply"        creates missing nodes from the mirror (folder, models, heads, lamps), adds missing tags and attributes
	                 (never overwrites an attribute that exists). Waypoint "traffic_lights_rebuild: before/after".
	  "disable-old"  turns the old Studio script TrafficLightCycle off (Enabled = false, attribute DisabledBy). Do this
	                 ONLY after the TrafficLightController is working (Play check), so the two do not fight.
	  "enable-old"   undo of disable-old.
	  "undo"         moves every node created by "apply" (attribute TLRebuilt) to ServerStorage.TrafficLights_Backup.
	Every mode returns a log string.
]]

local CS = game:GetService("CollectionService")
local ST = game:GetService("ServerStorage")
local CHS = game:GetService("ChangeHistoryService")
local HttpService = game:GetService("HttpService")

local MODE = tostring((...) or "dry")
local FOLDER = "TrafficLights"
local MAP_Z = 67.887287 -- world z = MAP_Z - map z
local MIRROR_URL = "http://127.0.0.1:8772/tools/assetplace/data/traffic_lights.luau"
local OLD_SCRIPT = "TrafficLightCycle"
local BACKUP = "TrafficLights_Backup"
local MARK = "TLRebuilt"

local log = {}
local function L(text)
	table.insert(log, text)
end
local function done()
	return table.concat(log, "\n")
end

-- MAP <-> world (the same involution both ways): position (-x, y, MAP_Z - z), rows 0 and 2 of the rotation negated
local function flip(cf)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return CFrame.new(-x, y, MAP_Z - z, -r00, -r01, -r02, r10, r11, r12, -r20, -r21, -r22)
end

local function assetsRoot()
	return workspace:FindFirstChild("MAP01_Assets")
end

local function findFolder()
	local root = assetsRoot()
	return root and root:FindFirstChild(FOLDER)
end

-- key of a child among same-named siblings: Name, Name~2, Name~3 ...
local function keyOf(inst)
	local parent = inst.Parent
	local n = 0
	for _, sibling in parent:GetChildren() do
		if sibling.Name == inst.Name then
			n += 1
			if sibling == inst then
				break
			end
		end
	end
	return if n > 1 then inst.Name .. "~" .. n else inst.Name
end

local function childByKey(parent, key)
	local name, nth = string.match(key, "^(.-)~(%d+)$")
	name = name or key
	nth = tonumber(nth) or 1
	local n = 0
	for _, child in parent:GetChildren() do
		if child.Name == name then
			n += 1
			if n == nth then
				return child
			end
		end
	end
	return nil
end

-- encode / decode of attributes in the mirror
local function enc(v)
	local t = typeof(v)
	if t == "Color3" then
		return string.format("{ C3 = { %.6g, %.6g, %.6g } }", v.R, v.G, v.B)
	elseif t == "Vector3" then
		return string.format("{ V3 = { %.6g, %.6g, %.6g } }", v.X, v.Y, v.Z)
	elseif t == "string" then
		return string.format("%q", v)
	elseif t == "number" then
		return string.format("%.9g", v)
	elseif t == "boolean" then
		return tostring(v)
	end
	return nil
end
local function dec(v)
	if type(v) == "table" then
		if v.C3 then
			return Color3.new(v.C3[1], v.C3[2], v.C3[3])
		elseif v.V3 then
			return Vector3.new(v.V3[1], v.V3[2], v.V3[3])
		end
	end
	return v
end

if MODE == "capture" then
	local folder = findFolder()
	if not folder then
		return "[err] workspace.MAP01_Assets.TrafficLights not found; nothing to capture"
	end
	local out = { "--!nocheck", "-- Mirror of workspace.MAP01_Assets.TrafficLights read from the Studio (MAP coordinates).", "-- Generated by traffic_lights_rebuild.luau (capture). Do not edit by hand.", "return {" }
	local count = 0
	local function walk(inst, path)
		for _, child in inst:GetChildren() do
			if child:IsA("LuaSourceContainer") then
				continue -- the old TrafficLightCycle script is code now
			end
			local p = if path == "" then keyOf(child) else path .. "/" .. keyOf(child)
			local f = { string.format("Path = %q", p), string.format("Name = %q", child.Name), string.format("Class = %q", child.ClassName) }
			if child:IsA("BasePart") then
				local cf = flip(child.CFrame)
				local comps = { cf:GetComponents() }
				local parts = {}
				for i, c in comps do
					parts[i] = string.format("%.7g", c)
				end
				table.insert(f, "CF = { " .. table.concat(parts, ", ") .. " }")
				table.insert(f, string.format("Size = { %.6g, %.6g, %.6g }", child.Size.X, child.Size.Y, child.Size.Z))
				table.insert(f, string.format("Color = { %.6g, %.6g, %.6g }", child.Color.R, child.Color.G, child.Color.B))
				table.insert(f, string.format("Material = %q", child.Material.Name))
				table.insert(f, string.format("Transparency = %.6g", child.Transparency))
				table.insert(f, "Anchored = " .. tostring(child.Anchored))
				table.insert(f, "CanCollide = " .. tostring(child.CanCollide))
				table.insert(f, "CanQuery = " .. tostring(child.CanQuery))
				table.insert(f, "CanTouch = " .. tostring(child.CanTouch))
				table.insert(f, "CastShadow = " .. tostring(child.CastShadow))
				if child:IsA("Part") then
					table.insert(f, string.format("Shape = %q", child.Shape.Name))
				end
				if child:IsA("MeshPart") then
					table.insert(f, string.format("MeshId = %q", child.MeshId))
				end
			end
			local attrs = {}
			for k, v in child:GetAttributes() do
				if k ~= MARK then
					local e = enc(v)
					if e then
						table.insert(attrs, string.format("[%q] = %s", k, e))
					end
				end
			end
			table.sort(attrs)
			table.insert(f, "Attrs = { " .. table.concat(attrs, ", ") .. " }")
			local tags = CS:GetTags(child)
			table.sort(tags)
			local tq = {}
			for _, t in tags do
				table.insert(tq, string.format("%q", t))
			end
			table.insert(f, "Tags = { " .. table.concat(tq, ", ") .. " }")
			table.insert(out, "\t{ " .. table.concat(f, ", ") .. " },")
			count += 1
			walk(child, p)
		end
	end
	-- the folder itself (attributes, tags) is entry "" implicitly: only its children are listed
	walk(folder, "")
	table.insert(out, "}")
	-- run("traffic_lights_rebuild", "capture", from, n): only lines from..from+n-1 of the source (the MCP output limit
	-- is ~100 kB; the full mirror is bigger). Concatenate the slices to get the file.
	local from, n = select(2, ...)
	if from then
		return table.concat(out, "\n", from, math.min(#out, from + (n or 100) - 1))
	end
	return string.format("-- %d nodes\n%s", count, table.concat(out, "\n"))
end

if MODE == "disable-old" or MODE == "enable-old" then
	local folder = findFolder()
	local script = folder and folder:FindFirstChild(OLD_SCRIPT)
	if not script then
		return "[ok] no " .. OLD_SCRIPT .. " in the folder (nothing to " .. MODE .. ")"
	end
	pcall(function()
		CHS:SetWaypoint("traffic_lights_rebuild " .. MODE .. ": before")
	end)
	if MODE == "disable-old" then
		pcall(function()
			script.Enabled = false
		end)
		pcall(function()
			script.Disabled = true
		end)
		script:SetAttribute("DisabledBy", "TrafficLightController")
	else
		pcall(function()
			script.Enabled = true
		end)
		pcall(function()
			script.Disabled = false
		end)
		script:SetAttribute("DisabledBy", nil)
	end
	pcall(function()
		CHS:SetWaypoint("traffic_lights_rebuild " .. MODE .. ": after")
	end)
	return string.format("[ok] %s %s (Enabled=%s)", MODE, OLD_SCRIPT, tostring(script.Enabled))
end

if MODE == "undo" then
	local folder = findFolder()
	if not folder then
		return "[ok] no folder, nothing to undo"
	end
	local backup = ST:FindFirstChild(BACKUP) or Instance.new("Folder")
	backup.Name = BACKUP
	backup.Parent = ST
	pcall(function()
		CHS:SetWaypoint("traffic_lights_rebuild undo: before")
	end)
	if folder:GetAttribute(MARK) then
		folder.Parent = backup -- whole folder was created by apply
		L("folder created by apply moved to ServerStorage." .. BACKUP)
	else
		for _, d in folder:GetDescendants() do
			if d:GetAttribute(MARK) and d.Parent and d.Parent ~= backup then
				local parentIsMarked = d.Parent:GetAttribute(MARK)
				if not parentIsMarked then
					d.Parent = backup
					L("moved " .. d.Name)
				end
			end
		end
	end
	pcall(function()
		CHS:SetWaypoint("traffic_lights_rebuild undo: after")
	end)
	return done()
end

-- dry / apply
local APPLY = MODE == "apply"
if MODE ~= "dry" and MODE ~= "apply" then
	return "[err] unknown mode " .. MODE .. " (capture | dry | apply | disable-old | enable-old | undo)"
end

local ok, source = pcall(function()
	return HttpService:GetAsync(MIRROR_URL, true)
end)
if not ok then
	return "[err] cannot load the mirror " .. MIRROR_URL .. " (" .. tostring(source) .. "). Run mode capture while the folder is intact and save it."
end
local fn, err = loadstring(source, "=traffic_lights")
if not fn then
	return "[err] mirror does not compile: " .. tostring(err)
end
local mirror = fn()

if APPLY then
	pcall(function()
		CHS:SetWaypoint("traffic_lights_rebuild: before")
	end)
end

local root = assetsRoot()
if not root then
	return "[err] workspace.MAP01_Assets is missing: run the map placement first"
end
local folder = root:FindFirstChild(FOLDER)
if not folder then
	L("[" .. (APPLY and "create" or "would create") .. "] folder " .. FOLDER)
	if APPLY then
		folder = Instance.new("Folder")
		folder.Name = FOLDER
		folder:SetAttribute(MARK, true)
		folder.Parent = root
	end
end

local made, tagged, attrSet = 0, 0, 0
local byPath = {} -- path -> instance (live or newly created)
for _, e in mirror do
	local parentPath = string.match(e.Path, "^(.*)/[^/]+$")
	local key = string.match(e.Path, "([^/]+)$")
	local parent = if parentPath then byPath[parentPath] else folder
	local inst = parent and childByKey(parent, key)
	if not inst then
		made += 1
		L("[" .. (APPLY and "create" or "would create") .. "] " .. e.Path .. " (" .. e.Class .. ")")
		if APPLY and parent then
			if e.Class == "Model" or e.Class == "Folder" then
				inst = Instance.new(e.Class)
			else
				inst = Instance.new(if e.Class == "WedgePart" then "WedgePart" else "Part")
				if e.Class ~= "Part" and e.Class ~= "WedgePart" then
					L("[warn] " .. e.Path .. ": " .. e.Class .. " rebuilt as Part (a mesh id cannot be set by script)")
				end
				inst.Size = Vector3.new(e.Size[1], e.Size[2], e.Size[3])
				inst.CFrame = flip(CFrame.new(table.unpack(e.CF)))
				inst.Color = Color3.new(e.Color[1], e.Color[2], e.Color[3])
				inst.Material = Enum.Material[e.Material] or Enum.Material.SmoothPlastic
				inst.Transparency = e.Transparency
				inst.Anchored = e.Anchored
				inst.CanCollide = e.CanCollide
				inst.CanQuery = e.CanQuery
				inst.CanTouch = e.CanTouch
				inst.CastShadow = e.CastShadow
				if e.Shape and inst:IsA("Part") then
					pcall(function()
						inst.Shape = Enum.PartType[e.Shape]
					end)
				end
			end
			inst.Name = e.Name
			inst:SetAttribute(MARK, true)
			inst.Parent = parent
		end
	end
	if inst then
		byPath[e.Path] = inst
		for k, v in e.Attrs do
			if inst:GetAttribute(k) == nil then
				attrSet += 1
				if APPLY then
					inst:SetAttribute(k, dec(v))
				end
			end
		end
		for _, tag in e.Tags do
			if not CS:HasTag(inst, tag) then
				tagged += 1
				if APPLY then
					CS:AddTag(inst, tag)
				end
			end
		end
	end
end

if APPLY then
	pcall(function()
		CHS:SetWaypoint("traffic_lights_rebuild: after")
	end)
end
L(string.format("[%s] nodes %d created, %d tags added, %d attributes set (mirror %d nodes)", MODE, made, tagged, attrSet, #mirror))
return done()

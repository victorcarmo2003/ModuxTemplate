  "text": "Low on stock? Try the Mart.",
  "sources": [
   "BossCalls.luau:362"
  ]
 },
 "v_7a64804dde": {
  "speaker": "walt",
  "text": "Low on stuff? Try the Mart.",
  "sources": [
   "Steps.luau:467 (Say)"
  ]
 },
 "v_2585223d7c": {
  "speaker": "walt",
  "text": "Mart's across the street.",
  "sources": [
   "Steps.luau:400 (Say)"
  ]
 },
 "v_922fb14183": {
  "speaker": "walt",
  "text": "Messed up? Toss it. No harm.",
  "sources": [
   "BossCalls.luau:370"
  ]
 },
 "v_146c67bf64": {
  "speaker": "walt",
  "text": "Morning! Told you nights were quiet.",
  "sources": [
   "BossCalls.luau:193"
  ]
 },
 "v_86f15e659d": {
  "speaker": "walt",
  "text": "Morning! You made it.",
  "sources": [
   "BossCalls.luau:194"
  ]
 },
 "v_4e6cef12f6": {
  "speaker": "walt",
  "text": "Morning, Marigold.",
  "sources": [
   "Cutscenes.luau:469 [finale]"
  ]
 },
 "v_6a998d7bee": {
  "speaker": "walt",
  "text": "Morning, Rookie! I'm on the line.",
  "sources": [
   "BossCalls.luau:180"
  ]
 },
 "v_3153f74405": {
  "speaker": "walt",
  "text": "Morning, Rookie. Sleep okay?",
  "sources": [
   "BossCalls.luau:195",
   "BossCalls.luau:196"
  ]
 },
 "v_74ca7ecbb8": {
  "speaker": "walt",
  "text": "Morning, Rookie. Walt here.",
  "sources": [
   "Steps.luau:590 (GREETING)"
  ]
 },
 "v_5e55db4a7b": {
  "speaker": "walt",
  "text": "My knees are done. But you... you notice things.",
  "sources": [
   "Cutscenes.luau:464 [finale]"
  ]
 },
 "v_f8d53173e0": {
  "speaker": "walt",
  "text": "New gear's on the trailer. Heh.",
  "sources": [
   "BossCalls.luau:371"
  ]
 },
 "v_edd36e4c4d": {
  "speaker": "walt",
  "text": "Nice and normal. Just right.",
  "sources": [
   "BossCalls.luau:210"
  ]
 },
 "v_b826ff9af4": {
  "speaker": "walt",
  "text": "Nice and normal. Sell some dogs.",
  "sources": [
   "BossCalls.luau:197"
  ]
 },
 "v_41c4165fcc": {
  "speaker": "walt",
  "text": "Nice flip.",
  "sources": [
   "Steps.luau:299 (Done)"
  ]
 },
 "v_ee709edf63": {
  "speaker": "walt",
  "text": "Nice! Cash goes in the drawer.",
  "sources": [
   "BossCalls.luau:362"
  ]
 },
 "v_213276c0ca": {
  "speaker": "walt",
  "text": "Nice.",
  "sources": [
   "Steps.luau:133 (Done)",
   "Steps.luau:269 (Done)"
  ]
 },
 "v_32bc643b2a": {
  "speaker": "walt",
  "text": "No face? Shut the window.",
  "sources": [
   "BossCalls.luau:233",
   "BossCalls.luau:234"
  ]
 },
 "v_d30128cf6d": {
  "speaker": "walt",
  "text": "No more nights for you.",
  "sources": [
   "BossCalls.luau:316"
  ]
 },
 "v_28189fdbed": {
  "speaker": "walt",
  "text": "Not what they asked. Toss it.",
  "sources": [
   "Steps.luau:204 (Say)",
   "Steps.luau:361 (Say)"
  ]
 },
 "v_5e48b92aca": {
  "speaker": "walt",
  "text": "Nothing extra.",
  "sources": [
   "BossCalls.luau:357",
   "Steps.luau:194 (Say)",
   "Steps.luau:350 (Say)"
  ]
 },
 "v_245112f77f": {
  "speaker": "walt",
  "text": "Now make the hot dog.",
  "sources": [
   "Steps.luau:121 (Say)"
  ]
 },
 "v_f4e083c4a2": {
  "speaker": "walt",
  "text": "Now serve it.",
  "sources": [
   "Steps.luau:224 (Say)"
  ]
 },
 "v_0aca9b5c3e": {
  "speaker": "walt",
  "text": "Now slice a bun.",
  "sources": [
   "BossCalls.luau:349"
  ]
 },
 "v_1ae72da760": {
  "speaker": "walt",
  "text": "One Mr. Pickett today, I hope.",
  "sources": [
   "BossCalls.luau:198"
  ]
 },
 "v_089cce41c0": {
  "speaker": "walt",
  "text": "Only chance I get. Be careful.",
  "sources": [
   "BossCalls.luau:308"
  ]
 },
 "v_082de8f3e6": {
  "speaker": "walt",
  "text": "Onto the grill.",
  "sources": [
   "Steps.luau:132 (Say)"
  ]
 },
 "v_3e0308863a": {
  "speaker": "walt",
  "text": "Open the window.",
  "sources": [
   "Steps.luau:90 (Say)"
  ]
 },
 "v_f2bed86855": {
  "speaker": "walt",
  "text": "Open up when ready.",
  "sources": [
   "BossCalls.luau:180"
  ]
 },
 "v_5a97b7101f": {
  "speaker": "walt",
  "text": "Out the back and hide. Quick.",
  "sources": [
   "BossCalls.luau:267"
  ]
 },
 "v_33b29ecd0d": {
  "speaker": "walt",
  "text": "Perfect.",
  "sources": [
   "Steps.luau:195 (Done)",
   "Steps.luau:351 (Done)"
  ]
 },
 "v_398e154586": {
  "speaker": "walt",
  "text": "Pick up the phone.",
  "sources": [
   "Steps.luau:72 (Remind)"
  ]
 },
 "v_576bda55a4": {
  "speaker": "walt",
  "text": "Pick up the plate.",
  "sources": [
   "Steps.luau:340 (Say)"
  ]
 },
 "v_d9eaa51ad3": {
  "speaker": "walt",
  "text": "Pickup counter. Hand it over.",
  "sources": [
   "Steps.luau:372 (Remind)"
  ]
 },
 "v_d8753a68f3": {
  "speaker": "walt",
  "text": "Pop a frank in the bun.",
  "sources": [
   "BossCalls.luau:350"
  ]
 },
 "v_58bc970fcf": {
  "speaker": "walt",
  "text": "Potato sticks and a bigger grill.",
  "sources": [
   "BossCalls.luau:196"
  ]
 },
 "v_e245baf6a4": {
  "speaker": "walt",
  "text": "Potato sticks today. Bigger grill, too.",
  "sources": [
   "BossCalls.luau:195"
  ]
 },
 "v_e9f9279ea5": {
  "speaker": "walt",
  "text": "Press Work at a station.",
  "sources": [
   "Steps.luau:123 (Remind)"
  ]
 },
 "v_d559c7aa79": {
  "speaker": "walt",
  "text": "Proud of you, Rookie. Really.",
  "sources": [
   "BossCalls.luau:207"
  ]
 },
 "v_e17886c499": {
  "speaker": "walt",
  "text": "Pull the window lever.",
  "sources": [
   "Steps.luau:92 (Remind)"
  ]
 },
 "v_3d658be667": {
  "speaker": "walt",
  "text": "Put it in the bun.",
  "sources": [
   "Steps.luau:184 (Remind)"
  ]
 },
 "v_631771189b": {
  "speaker": "walt",
  "text": "Ready. Grab it.",
  "sources": [
   "Steps.luau:171 (Say)"
  ]
 },
 "v_80cfebd202": {
  "speaker": "walt",
  "text": "Red fog on the street?",
  "sources": [
   "BossCalls.luau:257"
  ]
 },
 "v_4b62e371d4": {
  "speaker": "walt",
  "text": "Roof steps? Don't look up. Knocks? Don't open.",
  "sources": [
   "BossCalls.luau:281"
  ]
 },
 "v_3046ceb814": {
  "speaker": "walt",
  "text": "Roof steps? Hide. Knocks? Don't open.",
  "sources": [
   "BossCalls.luau:280"
  ]
 },
 "v_9a2f7f9949": {
  "speaker": "walt",
  "text": "Rookie. About the knocking.",
  "sources": [
   "BossCalls.luau:203"
  ]
 },
 "v_e2948c76ce": {
  "speaker": "walt",
  "text": "Rough night. Let's try again.",
  "sources": [
   "BossCalls.luau:308"
  ]
 },
 "v_e5619d79e3": {
  "speaker": "walt",
  "text": "Running low? Hit the stock room.",
  "sources": [
   "Steps.luau:444 (Say)"
  ]
 },
 "v_cea0c2176a": {
  "speaker": "walt",
  "text": "Same night, Rookie. Same rules.",
  "sources": [
   "BossCalls.luau:291"
  ]
 },
 "v_aaaf538e6f": {
  "speaker": "walt",
  "text": "Scratching under the floor?",
  "sources": [
   "BossCalls.luau:269"
  ]
 },
 "v_5d5fa8b89a": {
  "speaker": "walt",
  "text": "Scratching under the trailer?",
  "sources": [
   "BossCalls.luau:267"
  ]
 },
 "v_724be162d0": {
  "speaker": "walt",
  "text": "Scratching? Hide out back.",
  "sources": [
   "BossCalls.luau:268"
  ]
 },
 "v_aa5a08d1a0": {
  "speaker": "walt",
  "text": "Scratching? Up on the counter.",
  "sources": [
   "BossCalls.luau:269"
  ]
 },
 "v_9b6108722e": {
  "speaker": "walt",
  "text": "See the bubble? That's the order.",
  "sources": [
   "BossCalls.luau:357"
  ]
 },
 "v_05dd5b7b05": {
  "speaker": "walt",
  "text": "Shaking? Shut the window.",
  "sources": [
   "BossCalls.luau:239"
  ]
 },
 "v_f36e086018": {
  "speaker": "walt",
  "text": "She liked you. The lady.",
  "sources": [
   "BossCalls.luau:199"
  ]
 },
 "v_8d74b17c53": {
  "speaker": "walt",
  "text": "Shift's over, Rookie. Nice work.",
  "sources": [
   "BossCalls.luau:336"
  ]
 },
 "v_7c27354d0f": {
  "speaker": "walt",
  "text": "Short on cash? I've got you.",
  "sources": [
   "BossCalls.luau:340"
  ]
 },
 "v_478294cef8": {
  "speaker": "walt",
  "text": "Shut it. Stay inside till it's gone.",
  "sources": [
   "BossCalls.luau:257"
  ]
 },
 "v_5ae3e3e664": {
  "speaker": "walt",
  "text": "Shut the window, shop's closed.",
  "sources": [
   "BossCalls.luau:353"
  ]
 },
 "v_f25d60be6c": {
  "speaker": "walt",
  "text": "Shut the window.",
  "sources": [
   "BossCalls.luau:263"
  ]
 },
 "v_0b669707f9": {
  "speaker": "walt",
  "text": "Shut the window. Keep it shut.",
  "sources": [
   "BossCalls.luau:275"
  ]
 },
 "v_f001cae8c1": {
  "speaker": "walt",
  "text": "Shut the window. Keep working.",
  "sources": [
   "BossCalls.luau:238"
  ]
 },
 "v_d35f0f58c8": {
  "speaker": "walt",
  "text": "Slice a bun at the board.",
  "sources": [
   "Steps.luau:257 (Say)"
  ]
 },
 "v_a9764de43f": {
  "speaker": "walt",
  "text": "Slice a bun while it cooks.",
  "sources": [
   "Steps.luau:143 (Say)"
  ]
 },
 "v_2bd5e253a0": {
  "speaker": "walt",
  "text": "Somebody has to keep the light on. Every night.",
  "sources": [
   "Cutscenes.luau:463 [finale]"
  ]
 },
 "v_84845b02f9": {
  "speaker": "walt",
  "text": "Someone across the street? Don't look.",
  "sources": [
   "BossCalls.luau:251"
  ]
 },
 "v_d618b9d687": {
  "speaker": "walt",
  "text": "Someone shaking all over?",
  "sources": [
   "BossCalls.luau:238"
  ]
 },
 "v_08830d725e": {
  "speaker": "walt",
  "text": "Sometimes there's something special.",
  "sources": [
   "BossCalls.luau:367"
  ]
 },
 "v_44f85629fe": {
  "speaker": "walt",
  "text": "Start tonight. Keys under the mustard.",
  "sources": [
   "Cutscenes.luau:435 [intro]"
  ]
 },
 "v_65d88ea89e": {
  "speaker": "walt",
  "text": "Steps on the roof? Don't look up.",
  "sources": [
   "BossCalls.luau:281"
  ]
 },
 "v_fe63907641": {
  "speaker": "walt",
  "text": "Steps on the roof? Get out and hide.",
  "sources": [
   "BossCalls.luau:279"
  ]
 },
 "v_de8484defd": {
  "speaker": "walt",
  "text": "Stocked up!",
  "sources": [
   "Steps.luau:432 (Done)",
   "Steps.luau:456 (Done)"
  ]
 },
 "v_137c1443f9": {
  "speaker": "walt",
  "text": "Take a box off the shelf.",
  "sources": [
   "Steps.luau:446 (Remind)"
  ]
 },
 "v_0fde55b2de": {
  "speaker": "walt",
  "text": "Take a station. Follow the paw.",
  "sources": [
   "Steps.luau:121 (Say)"
  ]
 },
 "v_25b978ffa0": {
  "speaker": "walt",
  "text": "Take it from the pile.",
  "sources": [
   "Steps.luau:320 (Remind)"
  ]
 },
 "v_7267d65d8e": {
  "speaker": "walt",
  "text": "Take it to its station.",
  "sources": [
   "Steps.luau:455 (Say)"
  ]
 },
 "v_2ed2add83d": {
  "speaker": "walt",
  "text": "Take the order, Rookie.",
  "sources": [
   "Steps.luau:110 (Remind)"
  ]
 },
 "v_4d8a1537d4": {
  "speaker": "walt",
  "text": "Take the plate.",
  "sources": [
   "Steps.luau:341 (Remind)"
  ]
 },
 "v_141f160d69": {
  "speaker": "walt",
  "text": "Take their order at the tablet.",
  "sources": [
   "Steps.luau:237 (Say)"
  ]
 },
 "v_70561a888f": {
  "speaker": "walt",
  "text": "Take their order.",
  "sources": [
   "Steps.luau:108 (Say)"
  ]
 },
 "v_e06f57adaa": {
  "speaker": "walt",
  "text": "Tap the frank box. Grill it.",
  "sources": [
   "BossCalls.luau:180"
  ]
 },
 "v_59a8bd4b0f": {
  "speaker": "walt",
  "text": "Tap the tablet, Rookie.",
  "sources": [
   "Steps.luau:238 (Remind)"
  ]
 },
 "v_4550eb2216": {
  "speaker": "walt",
  "text": "Tell Opal it's for Walt.",
  "sources": [
   "BossCalls.luau:202"
  ]
 },
 "v_f271c54c14": {
  "speaker": "walt",
  "text": "Ten nights. You kept the light on.",
  "sources": [
   "Cutscenes.luau:457 [finale]"
  ]
 },
 "v_6643e2a67d": {
  "speaker": "walt",
  "text": "That was a joke. Mostly.",
  "sources": [
   "BossCalls.luau:198"
  ]
 },
 "v_15993e64ca": {
  "speaker": "walt",
  "text": "That was your last bun.",
  "sources": [
   "Steps.luau:399 (Say)"
  ]
 },
 "v_319d2c7703": {
  "speaker": "walt",
  "text": "That wasn't me. Believe that.",
  "sources": [
   "BossCalls.luau:203"
  ]
 },
 "v_6beee3781c": {
  "speaker": "walt",
  "text": "That's how you restock. Easy.",
  "sources": [
   "BossCalls.luau:369"
  ]
 },
 "v_e707824b1c": {
  "speaker": "walt",
  "text": "That's no customer. Shut the window.",
  "sources": [
   "BossCalls.luau:249"
  ]
 },
 "v_3e91827b5e": {
  "speaker": "walt",
  "text": "That's the job. You got this.",
  "sources": [
   "Steps.luau:592 (GOODBYE)"
  ]
 },
 "v_0236fd070b": {
  "speaker": "walt",
  "text": "That's the place.",
  "sources": [
   "Steps.luau:403 (Done)"
  ]
 },
 "v_d91e854ce1": {
  "speaker": "walt",
  "text": "That's two, Rookie.",
  "sources": [
   "BossCalls.luau:316"
  ]
 },
 "v_83d0e946e7": {
  "speaker": "walt",
  "text": "The corner's a crossing, Rookie. At night, the late crowd comes through.",
  "sources": [
   "Cutscenes.luau:460 [finale]"
  ]
 },
 "v_86b4351c71": {
  "speaker": "walt",
  "text": "The lamps are dying! Run INSIDE the Mart, now!",
  "sources": [
   "Radio:ANM-010.luau:47"
  ]
 },
 "v_d9a7a5ee99": {
  "speaker": "walt",
  "text": "The lamps outside are dying! Kill the lights in here, NOW!",
  "sources": [
   "Radio:ANM-010.luau:54"
  ]
 },
 "v_f3e7afb49b": {
  "speaker": "walt",
  "text": "The night shift is yours. If you want it.",
  "sources": [
   "Cutscenes.luau:466 [finale]"
  ]
 },
 "v_a407bfc9ae": {
  "speaker": "walt",
  "text": "They like the light. And the smell of food. Heh.",
  "sources": [
   "Cutscenes.luau:461 [finale]"
  ]
 },
 "v_9952411d1d": {
  "speaker": "walt",
  "text": "They want ketchup.",
  "sources": [
   "Steps.luau:194 (Say)",
   "Steps.luau:350 (Say)"
  ]
 },
 "v_909f41e668": {
  "speaker": "walt",
  "text": "Tonight's the last. I promise.",
  "sources": [
   "BossCalls.luau:203"
  ]
 },
 "v_7b2ac165bc": {
  "speaker": "walt",
  "text": "Toss it in the bin.",
  "sources": [
   "Steps.luau:205 (Remind)",
   "Steps.luau:362 (Remind)"
  ]
 },
 "v_7c172f2d01": {
  "speaker": "walt",
  "text": "Wait for the bar.",
  "sources": [
   "Steps.luau:162 (Say)",
   "Steps.luau:289 (Say)"
  ]
 },
 "v_242db04f33": {
  "speaker": "walt",
  "text": "Watch your drawer. Quick hands.",
  "sources": [
   "BossCalls.luau:189"
  ]
 },
 "v_455323adaa": {
  "speaker": "walt",
  "text": "We're open! Folks are lining up.",
  "sources": [
   "BossCalls.luau:353"
  ]
 },
 "v_ee99a20f74": {
  "speaker": "walt",
  "text": "We're open.",
  "sources": [
   "Steps.luau:91 (Done)"
  ]
 },
 "v_703c6e91b0": {
  "speaker": "walt",
  "text": "Whispers say hide? Hide out back.",
  "sources": [
   "BossCalls.luau:273"
  ]
 },
 "v_403f67f4e3": {
  "speaker": "walt",
  "text": "Whispers? Hide. Headlights? Window.",
  "sources": [
   "BossCalls.luau:274"
  ]
 },
 "v_17b7ec08b9": {
  "speaker": "walt",
  "text": "White eyes or twins? Shut the window.",
  "sources": [
   "BossCalls.luau:256"
  ]
 },
 "v_3ec9d5d404": {
  "speaker": "walt",
  "text": "White eyes? Twins in line? Shut the window.",
  "sources": [
   "BossCalls.luau:255",
   "BossCalls.luau:257"
  ]
 },
 "v_644d0f3f8e": {
  "speaker": "walt",
  "text": "You caught Quentin. Nice work.",
  "sources": [
   "BossCalls.luau:98"
  ]
 },
 "v_79fe1b45ba": {
  "speaker": "walt",
  "text": "You kept your eyes down. Good.",
  "sources": [
   "BossCalls.luau:201"
  ]
 },
 "v_197159850e": {
  "speaker": "walt",
  "text": "You noticed the flyer. Good.",
  "sources": [
   "Cutscenes.luau:434 [intro]"
  ]
 },
 "v_7a552ce2a2": {
  "speaker": "walt",
  "text": "You sound tired, Rookie...",
  "sources": [
   "BossCalls.luau:218"
  ]
 },
 "v_80f4cae4c8": {
  "speaker": "walt",
  "text": "You watched it, didn't you?",
  "sources": [
   "BossCalls.luau:301"
  ]
 },
 "v_7150b19925": {
  "speaker": "walt",
  "text": "You work late tonight. I'll ring.",
  "sources": [
   "BossCalls.luau:189"
  ]
 },
 "v_4d0c151fb2": {
  "speaker": "walt",
  "text": "Your first customer's coming.",
  "sources": [
   "Steps.luau:100 (Say)"
  ]
 }
}
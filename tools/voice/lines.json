  "speaker": "walt",
  "text": "A ketchup dog. Easy.",
  "sources": [
   "Steps.luau:98 (Done)"
  ]
 },
 "v_d4de2d7ad5": {
  "speaker": "walt",
  "text": "All white? Big grin? Refuse.",
  "sources": [
   "BossCalls.luau:259"
  ]
 },
